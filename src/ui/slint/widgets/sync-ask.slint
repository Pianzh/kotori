// 启动前那一问:云同步自检认不出"云端哪一条是本机这一款"时,起游戏之前问一次。
//
// 用户 2026-09-22:"云同步(打开游戏)前**必须自检**",而自检里**只有这一种情况**会打断
// 他。所以这个浮层只有一个职责:把问题说清楚,给四条出路。状态放在一个 **Slint 全局**里
// (照 `ProcessPickerState` 的先例),窗口不必替它转发一串属性。
//
// 用户 2026-09-24 定的两条:
//   * **关掉浮层(点空白/关闭)= 关掉这一款的同步,然后照常启动游戏** —— 自检绝不拦启动;
//   * 四条出路里的「改配对…」要真的能挑云端已有的一条(`CloudPickerState` 那个选择器),
//     挑完接着启动;挑不出来也没关系,他之后能在单游戏页里把这一款重新打开
//     (`sync_enabled` 的界面入口就是为这条出路做的)。

import { Tokens } from "../theme.slint";
import { AccentButton, StdButton } from "buttons.slint";

export global SyncAskState {
    in-out property <bool> open: false;
    /// 这一款叫什么(问题里要有名字,否则用户不知道说的是哪一款)。
    in-out property <string> game-name: "";
    /// 一句话解释:为什么问、云端有哪几条候选。空串 = 什么都别说。
    in-out property <string> message: "";

    /// 用户的回答:`ok`(没问题) / `pair`(新建一条身份) / `off`(关掉这一款的同步)。
    /// 三个回答之后都会**接着启动游戏**。
    callback answered(string);
    /// 「改配对…」:收起这一问、打开云端清单,从云端已有的一条里挑。
    callback pair-requested();
}

export component SyncAskDialog inherits Rectangle {
    width: 100%;
    height: 100%;

    // 遮罩:点空白处等于「关掉这一款的同步」,然后照常启动(不是"这次不启动")。
    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000073;
        TouchArea {
            mouse-cursor: pointer;
            clicked => { SyncAskState.answered("off"); }
        }
    }

    card := Rectangle {
        width: 480px;
        height: 396px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: Tokens.radius-card;
        background: Tokens.flyout;
        border-width: 1px;
        border-color: Tokens.flyout-stroke;

        body := VerticalLayout {
            x: 24px;
            y: 24px;
            width: parent.width - 48px;
            spacing: 10px;

            Text {
                text: "这一款在云端对不上号";
                font-size: 16px;
                font-weight: 600;
                color: Tokens.text;
            }
            Text {
                text: SyncAskState.game-name;
                font-size: 13px;
                color: Tokens.text-2;
            }
            Text {
                text: SyncAskState.message;
                font-size: 12px;
                color: Tokens.text-3;
                wrap: word-wrap;
            }

            // 四条出路,从"最省事"排到"最保守";每一行都写清后果 —— 猜错的代价是
            // 铺错存档,所以这里不能只有按钮名。
            AccentButton {
                label: "没问题，就同步这一款";
                button-width: parent.width;
                clicked => { SyncAskState.answered("ok"); }
            }
            StdButton {
                label: "改配对：绑到云端已有的那一条…";
                button-width: parent.width;
                clicked => { SyncAskState.pair_requested(); }
            }
            StdButton {
                label: "新建一条身份（云端这一款是另一份，跟它分开存）";
                button-width: parent.width;
                clicked => { SyncAskState.answered("pair"); }
            }
            StdButton {
                label: "关掉这一款的同步";
                button-width: parent.width;
                clicked => { SyncAskState.answered("off"); }
            }
            Text {
                text: "选哪一条都会照常开始游戏；关掉之后想再打开，去这一款的设置页把「参与云同步」重新打开。";
                font-size: 11px;
                color: Tokens.text-3;
                wrap: word-wrap;
            }
        }
    }
}
