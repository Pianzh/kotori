// 卡片组:设置页的主结构
//
// 这里只放「长得像 Win11、动效也对」的原语,不放业务。
// std-widgets 只借它的 ScrollView;其余全部自绘 —— Win11 的辨识度一半在
// 悬停/按下/展开的过渡上,内置样式改不动这些。

import { Tokens } from "../theme.slint";

// 一张设置卡片(卡片组里的一行)。控件放右边、垂直居中。
export component CardRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    // 说明文字的颜色:默认是灰的,设置页的「环境检查」要拿它当状态行(绿/红)。
    in property <color> description-color: Tokens.text-3;
    in property <bool> interactive: true;

    background: interactive && ta.has-hover ? #ffffff08 : #00000000;
    animate background { duration: 120ms; }
    height: layout.preferred-height;

    ta := TouchArea { }

    layout := HorizontalLayout {
        padding: 16px;
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text { text: root.title; font-size: 14px; font-weight: 600; color: Tokens.text; }
            Text {
                text: root.description;
                font-size: 12px;
                color: root.description-color;
                wrap: word-wrap;
                visible: root.description != "";
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}
export component Group inherits Rectangle {
    border-radius: Tokens.radius-card;
    border-width: 1px;
    border-color: Tokens.stroke;
    background: Tokens.card;
    height: layout.preferred-height;
    layout := VerticalLayout { @children }
}
// 卡片上方的小标题(Win11 里是 14px 半粗,和卡片留 8px)
export component SectionTitle inherits Text {
    font-size: 14px;
    font-weight: 600;
    color: Tokens.text;
}
