// 卡片组:设置页的主结构
//
// 这里只放「长得像 Win11、动效也对」的原语,不放业务。
// std-widgets 只借它的 ScrollView;其余全部自绘 —— Win11 的辨识度一半在
// 悬停/按下/展开的过渡上,内置样式改不动这些。

import { Tokens } from "../theme.slint";

// 一张设置卡片(卡片组里的一行)。控件放右边、垂直居中。
export component CardRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    // 说明文字的颜色:默认是灰的,设置页的「环境检查」要拿它当状态行(绿/红)。
    in property <color> description-color: Tokens.text-3;
    in property <bool> interactive: true;
    /// 整条可点（点进去看详情 / 下钻）。右侧控件放在下面（它们是 `@children`）就自动在
    /// 上层接住自己的点击，点在这些控件之外才轮到这一条 —— 与 `pages/games.slint` 的
    /// `GameRow` 同一条规矩（那边踩过：垫底的 `TouchArea` 声明晚了会盖住右边的按钮）。
    in property <bool> clickable: false;

    callback clicked();

    background: interactive && ta.has-hover ? #ffffff08 : #00000000;
    animate background { duration: 120ms; }
    height: layout.preferred-height;

    ta := TouchArea {
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { if (root.clickable) { root.clicked(); } }
    }

    layout := HorizontalLayout {
        padding: 16px;
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text { text: root.title; font-size: 14px; font-weight: 600; color: Tokens.text; }
            Text {
                text: root.description;
                font-size: 12px;
                color: root.description-color;
                wrap: word-wrap;
                visible: root.description != "";
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}
export component Group inherits Rectangle {
    border-radius: Tokens.radius-card;
    border-width: 1px;
    border-color: Tokens.stroke;
    background: Tokens.card;
    height: layout.preferred-height;
    layout := VerticalLayout { @children }
}
// 卡片上方的小标题(Win11 里是 14px 半粗,和卡片留 8px)
export component SectionTitle inherits Text {
    font-size: 14px;
    font-weight: 600;
    color: Tokens.text;
}
