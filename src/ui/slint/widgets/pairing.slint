// 「配对」:云端每一条身份 ↔ 本机哪一条档案。
//
// 状态放在一个 **Slint 全局**里(照 `ProcessPickerState` 的先例),而不是云端那页的
// 属性:这样窗口不必替它转发一大串属性与回调(那正好把 `app.slint` 顶过了行数硬线),
// 页面只负责画,Rust 直接推。
//
// 规则的说明在 `src/sync/pairing.rs`;这里只有画法。

import { Tokens } from "../theme.slint";
import { PairingItem } from "../types.slint";
import { RevealItem } from "base.slint";
import { Group, SectionTitle } from "card.slint";
import { StdButton } from "buttons.slint";

export global PairingBoard {
    /// 扫描结果。空数组且 `scanned` 为真 = 云端还没有游戏。
    in-out property <[PairingItem]> rows: [];
    in-out property <bool> scanned: false;
    in-out property <bool> scanning: false;
    /// 一句话状态(扫描结果 / 出错)。空串 = 什么都别说。
    in-out property <string> message: "";
    in-out property <bool> ok: true;

    callback scan();
    /// 用户点了一条候选:`(本机 id, 云端键, 云端身份)`。
    callback pair(string, string, string);
    /// 「不是同一款」:`(本机 id, 云端身份)`。
    callback reject(string, string);
}

export component SyncPairingSection inherits VerticalLayout {
    in property <bool> revealed: false;
    in property <int> title-step: 0;
    in property <int> group-step: 1;
    spacing: 0px;

    RevealItem {
        revealed: root.revealed;
        step: root.title-step;
        bottom: 8px;
        SectionTitle { text: "配对"; }
    }
    RevealItem {
        revealed: root.revealed;
        step: root.group-step;
        bottom: 24px;
        Group {
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "云端每一款游戏与本机哪一条档案是同一款。exe 指纹相同的自动绑上;其余的要你自己点。";
                        font-size: 12px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    StdButton {
                        label: PairingBoard.scanning ? "扫描中…" : "扫描云端";
                        button-width: 92px;
                        button-enabled: !PairingBoard.scanning;
                        clicked => { PairingBoard.scan(); }
                    }
                }
                if PairingBoard.message != "" : Text {
                    text: PairingBoard.message;
                    font-size: 12px;
                    color: PairingBoard.ok ? Tokens.text-3 : Tokens.danger;
                    wrap: word-wrap;
                }
                if PairingBoard.scanned && PairingBoard.rows.length == 0 : Text {
                    text: "云端还没有游戏。先「立即同步全部」把本机这一版传上去,再回来扫描。";
                    font-size: 12px;
                    color: Tokens.text-3;
                    wrap: word-wrap;
                }
                for row[index] in PairingBoard.rows : Rectangle {
                    background: Tokens.card;
                    border-color: Tokens.stroke;
                    border-width: 1px;
                    border-radius: Tokens.radius-card;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: "云端《" + row.cloud-name + "》";
                                font-size: 13px;
                                color: Tokens.text;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Text {
                                text: row.machines + " 台机器见过 · " + row.cloud-short;
                                font-size: 11px;
                                color: Tokens.text-3;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: row.detail;
                            font-size: 12px;
                            color: row.state >= 2 ? Tokens.warn : Tokens.text-2;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            for choice[slot] in row.choices : StdButton {
                                label: "绑到《" + choice.local-name + "》";
                                button-width: 150px;
                                clicked => { PairingBoard.pair(choice.local-id, row.cloud-key, row.cloud-id); }
                            }
                            if row.state == 0 || row.state == 1 : StdButton {
                                label: "不是同一款";
                                button-width: 104px;
                                clicked => { PairingBoard.reject(row.local-id, row.cloud-id); }
                            }
                        }
                    }
                }
            }
        }
    }
}
