// 单游戏设置页的底部动作:重置,以及「删除条目」的二次确认。
//
// ⚠ 这里**没有「保存」按钮**(2026-09-13 用户拍板):改一下就自动写回,状态由旁边那行
//    小字如实汇报(保存中 / 已自动保存 / 保存失败)。
//
// 单独一个文件,是因为"破坏性操作要二次确认"这条规矩连着措辞一起,值得一眼看全。

import { Tokens } from "../theme.slint";
import { RevealItem } from "../widgets/base.slint";
import { StdButton } from "../widgets/buttons.slint";

export component GameActions inherits Rectangle {
    in property <bool> revealed: false;
    in property <bool> saving: false;
    in property <string> saved-msg: "";
    in property <bool> saved-ok: true;
    in property <bool> confirm-delete: false;

    callback reset();
    callback delete-requested();
    callback delete-cancelled();
    callback delete-confirmed();

    height: layout.preferred-height;
    layout := VerticalLayout {            RevealItem {
                revealed: root.revealed;
                step: 8;
                bottom: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    StdButton {
                        label: "重置";
                        button-width: 84px;
                        // 自动保存之后它多半没什么可还原的 —— 那种情况会如实说
                        // 「没有未保存的改动」,而不是装作干了活(见 update.rs)。
                        clicked => { root.reset(); }
                    }
                    Text {
                        text: root.saving ? "保存中…" : root.saved-msg;
                        font-size: 12px;
                        color: root.saved-ok ? Tokens.ok : Tokens.danger;
                        vertical-alignment: center;
                        visible: root.saving || root.saved-msg != "";
                    }
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                }
            }

            // 删除是破坏性动作,所以它自己占一行、并且靠**右下角**:
            // 离「保存配置」远一点,手滑的代价小一点(用户 2026-09-13 要求)。
            RevealItem {
                revealed: root.revealed;
                step: 9;
                bottom: 0px;
                HorizontalLayout {
                    spacing: 10px;
                    // 这一根弹簧在前:整组(说明 + 按钮)贴右边。
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                    Text {
                        text: "删除这个条目?(不会删除游戏文件)";
                        font-size: 12px;
                        color: Tokens.danger;
                        vertical-alignment: center;
                        visible: root.confirm-delete;
                    }
                    StdButton {
                        label: root.confirm-delete ? "确认删除" : "删除条目";
                        button-width: 108px;
                        clicked => {
                            if (root.confirm-delete) { root.delete-confirmed(); }
                            else { root.delete-requested(); }
                        }
                    }
                    if root.confirm-delete : StdButton {
                        label: "取消";
                        button-width: 76px;
                        clicked => { root.delete-cancelled(); }
                    }
                }
            }
    }
}
