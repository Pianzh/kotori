// 「凭据」那一组(云同步页用):凭据存哪、主密码、B2 的 keyID/applicationKey。
//
// 单独一个文件是因为它最长,而且**只读状态与可编辑字段混在一起** ——
// 可编辑的那几个(输入框)由页面 `<=>` 绑进来,值仍然归页面所有(见 render.rs 的规矩)。

import { Tokens } from "../theme.slint";
import { Divider } from "../widgets/base.slint";
import { TextField } from "../widgets/controls.slint";
import { StdButton } from "../widgets/buttons.slint";
import { CardRow, Group } from "../widgets/card.slint";

export component SyncCredentialsGroup inherits Rectangle {
    // 只读状态
    // 0 系统密钥环 / 1 主密码加密文件 / 2 内存 / 3 明文文件(默认)
    in property <int> store-kind: 0;
    in property <bool> store-locked: false;
    // 明文/加密文件模式下凭据文件当前的位置(`keyring.store.path` 带过来的)。
    in property <string> store-path: "";
    // 主密码凭据文件的路径。三种存储下 daemon 都会报它(`keyring.secrets_file`),
    // 所以"凭据会存到哪 / 现在存在哪"都用它,不靠只读属性拼。
    in property <string> master-file: "";
    // 现在生效的那一级的名字(「明文凭据文件」/「系统密钥环」/「主密码凭据文件」/
    // 「本次会话的内存」)。措辞必须跟着它走,不许写死某一级。
    in property <string> store-name: "";
    in property <string> credentials-label: "";
    in property <string> master-hint: "";
    in property <bool> can-delete-credentials: false;
    in property <bool> confirm-master-delete: false;
    in property <bool> busy: false;

    // 可编辑(页面持有)
    in-out property <string> bucket: "";
    in-out property <string> key-id: "";
    in-out property <string> app-key: "";
    in-out property <string> master-password: "";

    callback field(int, string);
    callback save-credentials();
    callback clear-credentials();
    callback unlock();
    callback set-master-password();
    // 我们自己的那套方案(主密码加密文件):锁定、删除,以及删除前的二次确认。
    callback lock-credentials();
    callback delete-master-requested();
    callback delete-master-cancelled();
    callback delete-master-confirmed();

    height: group.height;
    group := Group {
                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;
                    Text {
                        text: "凭据默认明文保存在权限 0600 的文件里(只有你能读);也可以改用系统密钥环,或设主密码加密。现在用的是「" + root.store-name + "」。B2 凭据只保存一套,再次保存即覆盖。";
                        font-size: 12px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.credentials-label;
                        font-size: 11px;
                        color: root.can-delete-credentials ? Tokens.ok : Tokens.warn;
                        wrap: word-wrap;
                    }
                    // 没有可持久化后端时,先把话说在前面:这一页的保存按钮是禁用的,
                    // 免得用户以为存好了、重启后发现凭据没了(内存那一级只是过渡态)。
                    if root.store-kind == 2 : Text {
                        text: "⚠ 凭据文件写不下去(查一下配置目录的写权限),所以现在没有可持久化的后端 —— 请先设一个主密码(下面那一行),凭据才能保存。";
                        font-size: 11px;
                        color: Tokens.warn;
                        wrap: word-wrap;
                    }
                }
                // 主密码凭据文件 —— 我们自己的那套方案(Argon2id + ChaCha20-Poly1305)。
                // 锁着就先解锁;解锁着就能再锁定。两种状态都能删掉它:**忘了主密码时
                // 删除是唯一的出路**(`sync.clear_master_password` 不需要先解锁)。
                if root.store-kind == 1 : VerticalLayout {
                    Divider { }
                    CardRow {
                        title: "主密码凭据文件";
                        description: (root.store-locked ? "已锁定:" : "已解锁:")
                            + root.master-file
                            + (root.store-locked
                                ? " —— 输入主密码解锁,解锁后本次守护进程内一直有效。"
                                : " —— 凭据加密存在这里,磁盘上没有明文;锁定后要重新输一次主密码。");
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            if root.store-locked : TextField {
                                field-width: 200px;
                                password: true;
                                text <=> root.master-password;
                                edited(text) => { root.field(8, text); }
                                placeholder: "凭据文件的主密码";
                            }
                            if root.store-locked : StdButton {
                                label: "解锁";
                                button-width: 76px;
                                button-enabled: !root.busy;
                                clicked => { root.unlock(); }
                            }
                            if !root.store-locked : StdButton {
                                label: "锁定";
                                button-width: 76px;
                                button-enabled: !root.busy;
                                clicked => { root.lock-credentials(); }
                            }
                            StdButton {
                                label: "删除凭据文件";
                                button-width: 116px;
                                button-enabled: !root.busy && !root.confirm-master-delete;
                                clicked => { root.delete-master-requested(); }
                            }
                        }
                    }
                    if root.confirm-master-delete : HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        Text {
                            text: "删除凭据文件?存在里面的凭据会一起消失,而且无法恢复。";
                            font-size: 12px;
                            color: Tokens.danger;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        StdButton {
                            label: "取消";
                            button-width: 72px;
                            clicked => { root.delete-master-cancelled(); }
                        }
                        StdButton {
                            label: "确认删除";
                            button-width: 92px;
                            button-enabled: !root.busy;
                            clicked => { root.delete-master-confirmed(); }
                        }
                    }
                }
                // 还没有凭据文件:设一个主密码,把凭据搬进去。
                // ⚠ 本机没有密钥环时(store-kind == 2)这不是"可选",而是**唯一**能让
                //   凭据活过守护进程重启的路,所以措辞要直说。
                if root.store-kind != 1 : VerticalLayout {
                    Divider { }
                    CardRow {
                        title: "改成加密保存(可选)";
                        description: (root.store-kind == 3
                                ? "现在凭据是明文存在 " + root.store-path + "(权限 0600,只有你能读)。想要更严就设一个主密码,把凭据加密存到 "
                                : (root.store-kind == 2
                                    ? "凭据现在只能留在内存里,守护进程一重启就没了。设一个主密码,把凭据加密存到 "
                                    : "不想用系统密钥环也可以:设一个主密码,把凭据加密存到 "))
                            + root.master-file
                            + " —— 之后每次开机只要输一次主密码。密码由你自己保管,我们不会存它("
                            + root.master-hint + ")。";
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            TextField {
                                field-width: 200px;
                                password: true;
                                text <=> root.master-password;
                                edited(text) => { root.field(8, text); }
                                placeholder: "自己记得住就行";
                            }
                            StdButton {
                                label: "加密保存凭据";
                                button-width: 116px;
                                button-enabled: !root.busy;
                                clicked => { root.set-master-password(); }
                            }
                        }
                    }
                }
                Divider { }
                CardRow {
                    title: "bucket";
                    // 2026-09-18 从「连接与保留」搬进这一组(填 key 时顺手一起填)。
                    // ⚠ 这一步**不是用户拍板的**:用户的原话是问"是否应该放在凭据区",
                    // 位置还没定 —— 主 agent 验收时已把它当成越界点出来。用户说不留,
                    // 就把这块 CardRow 搬回「连接与保留」即可(值的所有权没动)。
                    // 值仍然随「保存设置」走,不跟下面的「保存凭据」走。
                    description: "Backblaze 控制台(B2 Cloud Storage → Buckets → Create a Bucket)里你自己建的桶的名字:全局唯一,重名要换一个;类型选 Private——存档不该公开可读。它不是凭据:只能访问这个桶的 keyID / applicationKey 在下面两行填。bucket 是整个桶,prefix 是桶里归 kotori 独占的目录(<bucket>/<prefix>/…),桶里放别的东西不冲突,kotori 只碰自己 prefix 下的路径。⚠ 它随「连接与保留」的「保存设置」一起保存,不跟下面的「保存凭据」走。";
                    TextField {
                        field-width: 220px;
                        text <=> root.bucket;
                        edited(text) => { root.field(1, text); }
                        placeholder: "kotori-saves";
                    }
                }
                Divider { }
                CardRow {
                    title: "keyID";
                    description: "B2 的 Application Key ID(形如 005a…)。";
                    TextField {
                        field-width: 240px;
                        text <=> root.key-id;
                        edited(text) => { root.field(4, text); }
                        placeholder: "Application Key ID";
                    }
                }
                Divider { }
                CardRow {
                    title: "applicationKey";
                    description: "只在创建时显示一次,丢了就再建一个。";
                    TextField {
                        field-width: 240px;
                        password: true;
                        text <=> root.app-key;
                        edited(text) => { root.field(5, text); }
                        placeholder: "只在创建时显示一次";
                    }
                }
                Divider { }
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    StdButton {
                        label: "保存凭据";
                        button-width: 96px;
                        // 只在有可持久化后端时能按(内存那一级不接受落点,见 update.rs)。
                        button-enabled: !root.busy && root.store-kind != 2;
                        clicked => { root.save-credentials(); }
                    }
                    StdButton {
                        label: "删除凭据";
                        button-width: 96px;
                        button-enabled: !root.busy && root.can-delete-credentials;
                        clicked => { root.clear-credentials(); }
                    }
                    Text {
                        text: root.store-kind == 2
                            ? "「保存凭据」现在是禁用的:连文件都写不下去,先把主密码设起来再存"
                            : "两个框填的都是同一个 B2 账号,下次保存会覆盖上一套" + (root.store-kind == 3 ? "(明文存到上面那个文件里)" : "");
                        font-size: 11px;
                        color: Tokens.text-3;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
    }
}
