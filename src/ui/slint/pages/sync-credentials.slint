// 「凭据」那一组(云同步页用):凭据存哪、主密码、B2 的 keyID/applicationKey、同步密码。
//
// 单独一个文件是因为它最长,而且**只读状态与可编辑字段混在一起** ——
// 可编辑的那几个(输入框)由页面 `<=>` 绑进来,值仍然归页面所有(见 render.rs 的规矩)。

import { Tokens } from "../theme.slint";
import { Divider } from "../widgets/base.slint";
import { TextField } from "../widgets/controls.slint";
import { StdButton } from "../widgets/buttons.slint";
import { CardRow, Group } from "../widgets/card.slint";

export component SyncCredentialsGroup inherits Rectangle {
    // 只读状态
    in property <int> store-kind: 0;
    in property <bool> store-locked: false;
    // 主密码凭据文件的路径。三种存储下 daemon 都会报它(`keyring.secrets_file`),
    // 所以"凭据会存到哪 / 现在存在哪"都用它,不靠只读属性拼。
    in property <string> master-file: "";
    // 三级存储里**现在生效**的那一级的名字(「系统密钥环」/「主密码凭据文件」/
    // 「本次会话的内存」)。措辞必须跟着它走 —— 没有密钥环的机器上凭据只在内存里。
    in property <string> store-name: "";
    in property <string> credentials-label: "";
    in property <string> password-hint: "";
    in property <string> master-hint: "";
    in property <bool> has-password: false;
    in property <bool> can-delete-credentials: false;
    in property <bool> confirm-master-delete: false;
    in property <bool> busy: false;

    // 可编辑(页面持有)
    in-out property <string> key-id: "";
    in-out property <string> app-key: "";
    in-out property <string> password: "";
    in-out property <string> password-again: "";
    in-out property <string> master-password: "";

    callback field(int, string);
    callback save-credentials();
    callback clear-credentials();
    callback save-password();
    callback clear-password();
    callback unlock();
    callback set-master-password();
    // 我们自己的那套方案(主密码加密文件):锁定、删除,以及删除前的二次确认。
    callback lock-credentials();
    callback delete-master-requested();
    callback delete-master-cancelled();
    callback delete-master-confirmed();

    height: group.height;
    group := Group {
                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;
                    Text {
                        text: "凭据三级存储:系统密钥环 → 主密码加密文件 → 仅本次会话。现在用的是「" + root.store-name + "」。B2 凭据只保存一套,再次保存即覆盖。";
                        font-size: 12px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.credentials-label;
                        font-size: 11px;
                        color: root.can-delete-credentials ? Tokens.ok : Tokens.warn;
                        wrap: word-wrap;
                    }
                }
                // 主密码凭据文件 —— 我们自己的那套方案(Argon2id + ChaCha20-Poly1305)。
                // 锁着就先解锁;解锁着就能再锁定。两种状态都能删掉它:**忘了主密码时
                // 删除是唯一的出路**(`sync.clear_master_password` 不需要先解锁)。
                if root.store-kind == 1 : VerticalLayout {
                    Divider { }
                    CardRow {
                        title: "主密码凭据文件";
                        description: (root.store-locked ? "已锁定:" : "已解锁:")
                            + root.master-file
                            + (root.store-locked
                                ? " —— 输入主密码解锁,解锁后本次守护进程内一直有效。"
                                : " —— 凭据加密存在这里,磁盘上没有明文;锁定后要重新输一次主密码。");
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            if root.store-locked : TextField {
                                field-width: 200px;
                                password: true;
                                text <=> root.master-password;
                                edited(text) => { root.field(8, text); }
                                placeholder: "凭据文件的主密码";
                            }
                            if root.store-locked : StdButton {
                                label: "解锁";
                                button-width: 76px;
                                button-enabled: !root.busy;
                                clicked => { root.unlock(); }
                            }
                            if !root.store-locked : StdButton {
                                label: "锁定";
                                button-width: 76px;
                                button-enabled: !root.busy;
                                clicked => { root.lock-credentials(); }
                            }
                            StdButton {
                                label: "删除凭据文件";
                                button-width: 116px;
                                button-enabled: !root.busy && !root.confirm-master-delete;
                                clicked => { root.delete-master-requested(); }
                            }
                        }
                    }
                    if root.confirm-master-delete : HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        Text {
                            text: "删除凭据文件?存在里面的凭据会一起消失,而且无法恢复。";
                            font-size: 12px;
                            color: Tokens.danger;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        StdButton {
                            label: "取消";
                            button-width: 72px;
                            clicked => { root.delete-master-cancelled(); }
                        }
                        StdButton {
                            label: "确认删除";
                            button-width: 92px;
                            button-enabled: !root.busy;
                            clicked => { root.delete-master-confirmed(); }
                        }
                    }
                }
                // 还没有凭据文件:设一个主密码,把凭据搬进去。
                // ⚠ 本机没有密钥环时(store-kind == 2)这不是"可选",而是**唯一**能让
                //   凭据活过守护进程重启的路,所以措辞要直说。
                if root.store-kind != 1 : VerticalLayout {
                    Divider { }
                    CardRow {
                        title: "主密码凭据文件";
                        description: (root.store-kind == 2
                                ? "本机没有可用的系统密钥环:凭据现在只在内存里,守护进程一重启就没了。设一个主密码,把凭据加密存到 "
                                : "不想用系统密钥环也可以:设一个主密码,把凭据加密存到 ")
                            + root.master-file
                            + " —— 之后每次开机只要输一次主密码。密码由你自己保管,我们不会存它("
                            + root.master-hint + ")。";
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            TextField {
                                field-width: 200px;
                                password: true;
                                text <=> root.master-password;
                                edited(text) => { root.field(8, text); }
                                placeholder: "自己记得住就行";
                            }
                            StdButton {
                                label: "加密保存凭据";
                                button-width: 116px;
                                button-enabled: !root.busy;
                                clicked => { root.set-master-password(); }
                            }
                        }
                    }
                }
                Divider { }
                CardRow {
                    title: "keyID";
                    description: "B2 的 Application Key ID(形如 005a…)。";
                    TextField {
                        field-width: 240px;
                        text <=> root.key-id;
                        edited(text) => { root.field(4, text); }
                        placeholder: "Application Key ID";
                    }
                }
                Divider { }
                CardRow {
                    title: "applicationKey";
                    description: "只在创建时显示一次,丢了就再建一个。";
                    TextField {
                        field-width: 240px;
                        password: true;
                        text <=> root.app-key;
                        edited(text) => { root.field(5, text); }
                        placeholder: "只在创建时显示一次";
                    }
                }
                Divider { }
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    StdButton {
                        label: "保存凭据";
                        button-width: 96px;
                        button-enabled: !root.busy;
                        clicked => { root.save-credentials(); }
                    }
                    StdButton {
                        label: "删除凭据";
                        button-width: 96px;
                        button-enabled: !root.busy && root.can-delete-credentials;
                        clicked => { root.clear-credentials(); }
                    }
                    Text {
                        text: "两个框填的都是同一个 B2 账号,下次保存会覆盖上一套";
                        font-size: 11px;
                        color: Tokens.text-3;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                Divider { }
                CardRow {
                    title: "同步密码";
                    description: "仅在开启加密时使用。密码由你自己设定,我们不会替你生成 —— 你从没见过的密码就等于把备份锁在别人手里。";
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        TextField {
                            field-width: 140px;
                            password: true;
                            text <=> root.password;
                            edited(text) => { root.field(6, text); }
                            placeholder: "留空 = 清除密码";
                        }
                        TextField {
                            field-width: 140px;
                            password: true;
                            text <=> root.password-again;
                            edited(text) => { root.field(7, text); }
                            placeholder: "再输一次";
                        }
                        StdButton {
                            label: "保存密码";
                            button-width: 84px;
                            button-enabled: !root.busy;
                            clicked => { root.save-password(); }
                        }
                        StdButton {
                            label: "删除密码";
                            button-width: 84px;
                            button-enabled: !root.busy && root.has-password;
                            clicked => { root.clear-password(); }
                        }
                    }
                }
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 14px;
                    spacing: 4px;
                    Text {
                        text: "密码状态:" + (root.has-password
                            ? "已保存在" + root.store-name + "(改密码会让已加密上传的存档无法解密,会再确认一次)"
                            : "未设置(没开加密就不需要它)");
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "自己取回密码的方式:" + root.password-hint;
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                }
    }
}
