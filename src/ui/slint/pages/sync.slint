// 「云同步」:本机情况 + 连接与保留设置 + 凭据。
// 对应后端 `sync status|set_settings|set_credentials|unlock|set_master_password|test|now|restore`
// (ADR-012/013:rclone 原生 b2,一版一个 zip;自动取回只取更新的,恢复就是铺一整版)。
//
// 可编辑字段的归属与单游戏设置页同一套:页面自己拥有输入框的值,Rust 只在值真的不同时
// 才写回来(见 render.rs)。凭据永远不回显 —— 保存成功后输入框会被清空,而不是填上星号。

import { ScrollView } from "std-widgets.slint";
import { Tokens } from "../theme.slint";
import { Divider, RevealItem } from "../widgets/base.slint";
import { Switch, TextField } from "../widgets/controls.slint";
import { PathField } from "../widgets/path-field.slint";
import { AccentButton, StdButton } from "../widgets/buttons.slint";
import { CardRow, Group, SectionTitle } from "../widgets/card.slint";
import { SyncCredentialsGroup } from "sync-credentials.slint";
import { SyncKopiaGroup } from "sync-kopia.slint";
import { SyncBoard } from "../state/sync-board.slint";

export component SyncPage inherits ScrollView {
    // 见 `games.slint` 里的长注释:fluent 默认关掉拖拽滚动,没有滚轮的机器要靠这一行。
    mouse-drag-pan-enabled: true;
    // 状态与回调都在 `SyncBoard` 里(见那个文件头)。那些字段不属于这一页,而属于窗口:
    // Rust 把它当成一份表单来推、来收,和页面此刻是不是正显示无关。
    //
    // 页面自己只留两样私有的东西:入场动画的开关,以及窗口注入的「浏览…能不能用」。
    // 「浏览…」这台机器上能不能用（与其它页面同一个来源，理由在 `path-hint` 里）。
    in property <bool> browse-enabled: true;
    in-out property <bool> revealed: false;

    Timer { interval: 40ms; running: true; triggered => { root.revealed = true; } }

    VerticalLayout {
        padding-left: root.revealed ? 28px : 68px;
        animate padding-left { duration: 260ms; easing: ease-out; }
        padding-right: 28px;
        padding-top: 12px;
        padding-bottom: 32px;
        spacing: 0px;

        // ── 头 ────────────────────────────────────────────────────────────
        RevealItem {
            revealed: root.revealed;
            step: 0;
            bottom: 20px;
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "云同步"; font-size: 28px; font-weight: 600; color: Tokens.text; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: SyncBoard.ready ? "● 已就绪" : (SyncBoard.problem != "" ? "● 待解决" : "● 未就绪");
                            font-size: 13px;
                            color: SyncBoard.ready ? Tokens.ok : (SyncBoard.problem != "" ? Tokens.warn : Tokens.text-3);
                        }
                        Text {
                            text: SyncBoard.remote;
                            font-size: 13px;
                            color: Tokens.text-3;
                            overflow: elide;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 10px;
                        StdButton {
                            label: "测试连接";
                            button-width: 88px;
                            button-enabled: !SyncBoard.busy;
                            clicked => { SyncBoard.test(); }
                        }
                        StdButton {
                            label: "立即同步全部";
                            button-width: 112px;
                            button-enabled: !SyncBoard.busy;
                            clicked => { SyncBoard.now(""); }
                        }
                    }
                }
            }
        }

        // ── 本机情况 ──────────────────────────────────────────────────────
        RevealItem {
            revealed: root.revealed;
            step: 1;
            bottom: 8px;
            SectionTitle { text: "本机情况"; }
        }
        RevealItem {
            revealed: root.revealed;
            step: 2;
            bottom: 24px;
            Group {
                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;
                    Text {
                        text: SyncBoard.loaded ? (SyncBoard.rclone != "" ? "rclone:" + SyncBoard.rclone : "rclone 未安装(Arch:sudo pacman -S rclone)") : "读取中…";
                        font-size: 11px;
                        color: SyncBoard.rclone != "" || !SyncBoard.loaded ? Tokens.text-3 : Tokens.warn;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "凭据存放:" + SyncBoard.keyring;
                        font-size: 11px;
                        color: SyncBoard.ephemeral ? Tokens.warn : Tokens.text-3;
                        wrap: word-wrap;
                    }
                    if SyncBoard.ephemeral : Text {
                        text: "⚠ 连凭据文件都写不下去,填进去的凭据只留在内存里,重启后要重新输入。";
                        font-size: 11px;
                        color: Tokens.warn;
                        wrap: word-wrap;
                    }
                    if SyncBoard.ephemeral : Text {
                        text: SyncBoard.keyring-hint;
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                    if SyncBoard.problem != "" : Text {
                        text: "待解决:" + SyncBoard.problem;
                        font-size: 11px;
                        color: Tokens.warn;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ── 连接与保留 ────────────────────────────────────────────────────
        RevealItem {
            revealed: root.revealed;
            step: 3;
            bottom: 8px;
            SectionTitle { text: "连接与保留"; }
        }
        RevealItem {
            revealed: root.revealed;
            step: 4;
            bottom: 24px;
            Group {
                CardRow {
                    title: "启用云同步";
                    description: "退出游戏后自动上传存档,启动前自动取回较新的版本。";
                    Switch {
                        checked <=> SyncBoard.enabled;
                        toggled => { SyncBoard.enabled-toggled(SyncBoard.enabled); }
                    }
                }
                Divider { }
                CardRow {
                    title: "同步方式";
                    description: "两种方式在桶里各写各的区域,互相看不见对方的数据(数据都还在,只是这边读不出来)。双系统/多机必须选同一种。";
                    HorizontalLayout {
                        spacing: 8px;
                        StdButton {
                            label: SyncBoard.engine == "rclone" ? "rclone(zip) √" : "rclone(zip)";
                            button-width: 124px;
                            button-enabled: !SyncBoard.busy && SyncBoard.engine != "rclone";
                            clicked => { SyncBoard.engine-selected("rclone"); }
                        }
                        StdButton {
                            label: SyncBoard.engine == "kopia" ? "kopia √" : "kopia";
                            button-width: 96px;
                            button-enabled: !SyncBoard.busy && SyncBoard.engine != "kopia";
                            clicked => { SyncBoard.engine-selected("kopia"); }
                        }
                    }
                }
                Divider { }
                CardRow {
                    title: "rclone 程序位置";
                    description: "rclone 可执行文件在哪。填目录或完整路径都行；留空＝由 Kotori 自己去找。把 rclone 放在一个目录里、不想动 PATH 的人用这一项。";
                    VerticalLayout {
                        spacing: 4px;
                        PathField {
                            field-width: 300px;
                            text <=> SyncBoard.rclone-input;
                            edited(text) => { SyncBoard.field(8, text); }
                            browse-enabled: root.browse-enabled;
                            browse-clicked => { SyncBoard.browse-rclone-binary(); }
                            placeholder: "留空＝自己去 PATH 里找";
                        }
                        Text {
                            text: SyncBoard.rclone == "" ? "当前：没找到 rclone" : "当前：" + SyncBoard.rclone;
                            font-size: 11px;
                            color: Tokens.text-3;
                            wrap: word-wrap;
                        }
                    }
                }
                Divider { }
                CardRow {
                    title: "kopia 程序位置";
                    description: "kopia 可执行文件在哪。填目录或完整路径都行；留空＝由 Kotori 自己去找（先看 KOTORI_KOPIA 环境变量，再看 Kotori 自己的目录，最后 PATH）。";
                    VerticalLayout {
                        spacing: 4px;
                        PathField {
                            field-width: 300px;
                            text <=> SyncBoard.kopia-input;
                            edited(text) => { SyncBoard.field(9, text); }
                            browse-enabled: root.browse-enabled;
                            browse-clicked => { SyncBoard.browse-kopia-binary(); }
                            placeholder: "留空＝自己去 PATH 里找";
                        }
                        Text {
                            text: SyncBoard.kopia-binary == "" ? "当前：没找到 kopia" : "当前：" + SyncBoard.kopia-binary;
                            font-size: 11px;
                            color: Tokens.text-3;
                            wrap: word-wrap;
                        }
                    }
                }
                Divider { }
                CardRow {
                    title: "bucket";
                    // ⚠ **别把它搬走**(2026-09-21 用户报"打了字但没保存生效,重开又变回旧的"):
                    // 它 2026-09-18 曾被搬到最下面「凭据」组里,而那一组的按钮是「保存凭据」
                    // —— 那颗**不存桶名**(凭据进密钥环、桶名进 config),于是"填在下面、
                    // 存在上面"变成一个人人都会踩的坑。它现在就在自己的保存按钮上面一行。
                    description: "Backblaze 控制台(B2 Cloud Storage → Buckets → Create a Bucket)里你自己建的桶的名字:全局唯一,重名要换一个;类型选 Private——存档不该公开可读。它不是凭据:只能访问这个桶的 keyID / applicationKey 在凭据区填。bucket 是整个桶,下面那行 prefix 是桶里归 Kotori 独占的目录(<bucket>/<prefix>/…),桶里放别的东西不冲突,Kotori 只碰自己 prefix 下的路径。⚠ 随本组最下面的「保存设置」一起保存。";
                    TextField {
                        field-width: 220px;
                        text <=> SyncBoard.bucket;
                        edited(text) => { SyncBoard.field(1, text); }
                        placeholder: "kotori-saves";
                    }
                }
                Divider { }
                CardRow {
                    title: "prefix";
                    description: "bucket 里归 Kotori 独占的目录(bucket 在上面那一行填),bucket 里的其他东西我们一律不碰。";
                    TextField {
                        field-width: 220px;
                        text <=> SyncBoard.prefix;
                        edited(text) => { SyncBoard.field(2, text); }
                        placeholder: "Kotori";
                    }
                }
                Divider { }
                CardRow {
                    title: "API endpoint";
                    description: "留空即可(rclone 会自己找到)。填 s3.<区域>.backblazeb2.com 会被明确拒绝 —— 那对 s3 后端才成立。";
                    TextField {
                        field-width: 220px;
                        text <=> SyncBoard.endpoint;
                        edited(text) => { SyncBoard.field(0, text); }
                        placeholder: "留空";
                    }
                }
                Divider { }
                CardRow {
                    title: "保留版本数";
                    description: "0 表示永不删除云端版本;填写后只清理旧版本包,绝不动本地存档。";
                    TextField {
                        field-width: 100px;
                        text <=> SyncBoard.keep-versions;
                        edited(text) => { SyncBoard.field(3, text); }
                        placeholder: "0";
                    }
                }
                Divider { }
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    AccentButton {
                        label: "保存设置";
                        button-width: 108px;
                        button-enabled: !SyncBoard.busy;
                        clicked => { SyncBoard.save-settings(); }
                    }
                    Text {
                        text: SyncBoard.message;
                        font-size: 12px;
                        color: SyncBoard.message-ok ? Tokens.ok : Tokens.danger;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        visible: SyncBoard.message != "";
                    }
                }
            }
        }

        // ── kopia 仓库(只在 kopia 模式下) ───────────────────────────────
        if SyncBoard.engine == "kopia" : RevealItem {
            revealed: root.revealed;
            step: 4;
            bottom: 8px;
            SectionTitle { text: "kopia 仓库"; }
        }
        if SyncBoard.engine == "kopia" : RevealItem {
            revealed: root.revealed;
            step: 5;
            bottom: 24px;
            SyncKopiaGroup {
                binary: SyncBoard.kopia-binary;
                bucket: SyncBoard.bucket;
                repo-prefix: SyncBoard.kopia-prefix;
                password-state: SyncBoard.kopia-password-state;
                using-default: SyncBoard.kopia-using-default;
                busy: SyncBoard.busy;
                password <=> SyncBoard.kopia-password;
                revealed <=> SyncBoard.connection-revealed;
                field(id, text) => { SyncBoard.field(id, text); }
                save-password => { SyncBoard.save-kopia-password(); }
            }
        }

        // ── 凭据 ──────────────────────────────────────────────────────────
        RevealItem {
            revealed: root.revealed;
            step: 5;
            bottom: 8px;
            SectionTitle { text: "凭据"; }
        }
        RevealItem {
            revealed: root.revealed;
            step: 6;
            bottom: 24px;
                SyncCredentialsGroup {
                    store-kind: SyncBoard.store-kind;
                    store-locked: SyncBoard.store-locked;
                    store-path: SyncBoard.store-path;
                    master-file: SyncBoard.master-file;
                    store-name: SyncBoard.store-name;
                    confirm-master-delete: SyncBoard.confirm-master-delete;
                    credentials-label: SyncBoard.credentials-label;
                    master-hint: SyncBoard.master-hint;
                    can-delete-credentials: SyncBoard.can-delete-credentials;
                    busy: SyncBoard.busy;
                    key-id <=> SyncBoard.key-id;
                    app-key <=> SyncBoard.app-key;
                    master-password <=> SyncBoard.master-password;
                    field(id, text) => { SyncBoard.field(id, text); }
                    save-credentials => { SyncBoard.save-credentials(); }
                    clear-credentials => { SyncBoard.clear-credentials(); }
                    unlock => { SyncBoard.unlock(); }
                    set-master-password => { SyncBoard.set-master-password(); }
                    lock-credentials => { SyncBoard.lock-credentials(); }
                    delete-master-requested => { SyncBoard.delete-master-requested(); }
                    delete-master-cancelled => { SyncBoard.delete-master-cancelled(); }
                    delete-master-confirmed => { SyncBoard.delete-master-confirmed(); }
                }
        }

        Rectangle { vertical-stretch: 1; background: #00000000; }
    }
}
