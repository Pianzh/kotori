// 「云同步」:本机情况 + 连接与保留设置 + 凭据。
// 对应后端 `sync status|set_settings|set_credentials|unlock|set_master_password|test|now|restore`
// (ADR-012/013:rclone 原生 b2,一版一个 zip;自动取回只取更新的,恢复就是铺一整版)。
//
// 可编辑字段的归属与单游戏设置页同一套:页面自己拥有输入框的值,Rust 只在值真的不同时
// 才写回来(见 render.rs)。凭据永远不回显 —— 保存成功后输入框会被清空,而不是填上星号。

import { ScrollView } from "std-widgets.slint";
import { Tokens } from "../theme.slint";
import { Divider, RevealItem } from "../widgets/base.slint";
import { Switch, TextField } from "../widgets/controls.slint";
import { AccentButton, StdButton } from "../widgets/buttons.slint";
import { CardRow, Group, SectionTitle } from "../widgets/card.slint";
import { SyncCredentialsGroup } from "sync-credentials.slint";
import { SyncKopiaGroup } from "sync-kopia.slint";

export component SyncPage inherits ScrollView {
    // 见 `games.slint` 里的长注释:fluent 默认关掉拖拽滚动,没有滚轮的机器要靠这一行。
    mouse-drag-pan-enabled: true;
    // ── 只读状态(daemon 报什么就显示什么) ────────────────────────────────
    in property <bool> loaded: false;
    in property <string> remote: "";
    in property <string> rclone: "";
    /// 当前引擎:`rclone` | `kopia`。两个引擎在桶里各写各的区域,所以这一条必须
    /// 显示出来 —— 选错了不会报错,只会"看不见对面的存档"。
    in property <string> engine: "rclone";
    in property <string> kopia-binary: "";
    in property <string> kopia-prefix: "";
    /// 密码状态那句话(「默认 kotori」/「已自己设置」)。
    in property <string> kopia-password-state: "";
    in property <bool> kopia-using-default: true;
    in property <string> keyring: "";
    in property <bool> ephemeral: false;
    in property <string> keyring-hint: "";
    in property <string> problem: "";
    in property <bool> ready: false;
    in property <string> credentials-label: "";
    in property <string> master-hint: "";
    in property <int> store-kind: 0;          // 0 系统密钥环 / 1 主密码文件 / 2 仅本次会话
    in property <bool> store-locked: false;
    in property <string> store-path: "";
    in property <string> master-file: "";
    // 三级存储里现在生效的那一级的名字(「系统密钥环」/「主密码凭据文件」/「本次会话的内存」)。
    in property <string> store-name: "";
    in property <bool> confirm-master-delete: false;
    in property <bool> can-delete-credentials: false;

    // ── 可编辑 ────────────────────────────────────────────────────────────
    // ⚠ 不能叫 `enabled`:ScrollView(std-widgets)自带这个属性名,重名编译器会拒绝。
    in-out property <bool> sync-enabled: false;
    in-out property <string> bucket: "";
    in-out property <string> prefix: "";
    in-out property <string> endpoint: "";
    in-out property <string> keep-versions: "";
    in-out property <string> key-id: "";
    in-out property <string> app-key: "";
    in-out property <string> master-password: "";
    in-out property <string> kopia-password: "";
    in-out property <bool> connection-revealed: false;

    in property <bool> busy: false;
    in property <string> message: "";
    in property <bool> message-ok: true;

    in-out property <bool> revealed: false;

    callback enabled-toggled(bool);
    callback engine-selected(string);
    callback field(int, string);
    callback save-settings();
    callback save-kopia-password();
    callback test();
    callback sync-now(string);
    callback restore(string);
    callback restore-confirmed();
    callback restore-cancelled();
    callback save-credentials();
    callback clear-credentials();
    callback unlock();
    callback set-master-password();
    callback lock-credentials();
    callback delete-master-requested();
    callback delete-master-cancelled();
    callback delete-master-confirmed();

    Timer { interval: 40ms; running: true; triggered => { root.revealed = true; } }

    VerticalLayout {
        padding-left: root.revealed ? 28px : 68px;
        animate padding-left { duration: 260ms; easing: ease-out; }
        padding-right: 28px;
        padding-top: 12px;
        padding-bottom: 32px;
        spacing: 0px;

        // ── 头 ────────────────────────────────────────────────────────────
        RevealItem {
            revealed: root.revealed;
            step: 0;
            bottom: 20px;
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "云同步"; font-size: 28px; font-weight: 600; color: Tokens.text; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.ready ? "● 已就绪" : (root.problem != "" ? "● 待解决" : "● 未就绪");
                            font-size: 13px;
                            color: root.ready ? Tokens.ok : (root.problem != "" ? Tokens.warn : Tokens.text-3);
                        }
                        Text {
                            text: root.remote;
                            font-size: 13px;
                            color: Tokens.text-3;
                            overflow: elide;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 10px;
                        StdButton {
                            label: "测试连接";
                            button-width: 88px;
                            button-enabled: !root.busy;
                            clicked => { root.test(); }
                        }
                        StdButton {
                            label: "立即同步全部";
                            button-width: 112px;
                            button-enabled: !root.busy;
                            clicked => { root.sync-now(""); }
                        }
                    }
                }
            }
        }

        // ── 本机情况 ──────────────────────────────────────────────────────
        RevealItem {
            revealed: root.revealed;
            step: 1;
            bottom: 8px;
            SectionTitle { text: "本机情况"; }
        }
        RevealItem {
            revealed: root.revealed;
            step: 2;
            bottom: 24px;
            Group {
                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;
                    Text {
                        text: root.loaded ? (root.rclone != "" ? "rclone:" + root.rclone : "rclone 未安装(Arch:sudo pacman -S rclone)") : "读取中…";
                        font-size: 11px;
                        color: root.rclone != "" || !root.loaded ? Tokens.text-3 : Tokens.warn;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "凭据存放:" + root.keyring;
                        font-size: 11px;
                        color: root.ephemeral ? Tokens.warn : Tokens.text-3;
                        wrap: word-wrap;
                    }
                    if root.ephemeral : Text {
                        text: "⚠ 连凭据文件都写不下去,填进去的凭据只留在内存里,重启后要重新输入。";
                        font-size: 11px;
                        color: Tokens.warn;
                        wrap: word-wrap;
                    }
                    if root.ephemeral : Text {
                        text: root.keyring-hint;
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                    if root.problem != "" : Text {
                        text: "待解决:" + root.problem;
                        font-size: 11px;
                        color: Tokens.warn;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ── 连接与保留 ────────────────────────────────────────────────────
        RevealItem {
            revealed: root.revealed;
            step: 3;
            bottom: 8px;
            SectionTitle { text: "连接与保留"; }
        }
        RevealItem {
            revealed: root.revealed;
            step: 4;
            bottom: 24px;
            Group {
                CardRow {
                    title: "启用云同步";
                    description: "退出游戏后自动上传存档,启动前自动取回较新的版本。";
                    Switch {
                        checked <=> root.sync-enabled;
                        toggled => { root.enabled-toggled(root.sync-enabled); }
                    }
                }
                Divider { }
                CardRow {
                    title: "同步方式";
                    description: "两种方式在桶里各写各的区域,互相看不见对方的数据(数据都还在,只是这边读不出来)。双系统/多机必须选同一种。";
                    HorizontalLayout {
                        spacing: 8px;
                        StdButton {
                            label: root.engine == "rclone" ? "rclone(zip) ✓" : "rclone(zip)";
                            button-width: 124px;
                            button-enabled: !root.busy && root.engine != "rclone";
                            clicked => { root.engine-selected("rclone"); }
                        }
                        StdButton {
                            label: root.engine == "kopia" ? "kopia ✓" : "kopia";
                            button-width: 96px;
                            button-enabled: !root.busy && root.engine != "kopia";
                            clicked => { root.engine-selected("kopia"); }
                        }
                    }
                }
                Divider { }
                CardRow {
                    title: "bucket";
                    description: "B2 上那个 bucket 的名字。";
                    TextField {
                        field-width: 220px;
                        text <=> root.bucket;
                        edited(text) => { root.field(1, text); }
                        placeholder: "kotori-saves";
                    }
                }
                Divider { }
                CardRow {
                    title: "prefix";
                    description: "bucket 里归 kotori 独占的目录,bucket 里的其他东西我们一律不碰。";
                    TextField {
                        field-width: 220px;
                        text <=> root.prefix;
                        edited(text) => { root.field(2, text); }
                        placeholder: "kotori";
                    }
                }
                Divider { }
                CardRow {
                    title: "API endpoint";
                    description: "留空即可(rclone 会自己找到)。填 s3.<区域>.backblazeb2.com 会被明确拒绝 —— 那对 s3 后端才成立。";
                    TextField {
                        field-width: 220px;
                        text <=> root.endpoint;
                        edited(text) => { root.field(0, text); }
                        placeholder: "留空";
                    }
                }
                Divider { }
                CardRow {
                    title: "保留版本数";
                    description: "0 表示永不删除云端版本;填写后只清理旧版本包,绝不动本地存档。";
                    TextField {
                        field-width: 100px;
                        text <=> root.keep-versions;
                        edited(text) => { root.field(3, text); }
                        placeholder: "0";
                    }
                }
                Divider { }
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    AccentButton {
                        label: "保存设置";
                        button-width: 108px;
                        button-enabled: !root.busy;
                        clicked => { root.save-settings(); }
                    }
                    Text {
                        text: root.message;
                        font-size: 12px;
                        color: root.message-ok ? Tokens.ok : Tokens.danger;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        visible: root.message != "";
                    }
                }
            }
        }

        // ── kopia 仓库(只在 kopia 模式下) ───────────────────────────────
        if root.engine == "kopia" : RevealItem {
            revealed: root.revealed;
            step: 4;
            bottom: 8px;
            SectionTitle { text: "kopia 仓库"; }
        }
        if root.engine == "kopia" : RevealItem {
            revealed: root.revealed;
            step: 5;
            bottom: 24px;
            SyncKopiaGroup {
                binary: root.kopia-binary;
                bucket: root.bucket;
                repo-prefix: root.kopia-prefix;
                password-state: root.kopia-password-state;
                using-default: root.kopia-using-default;
                busy: root.busy;
                password <=> root.kopia-password;
                revealed <=> root.connection-revealed;
                field(id, text) => { root.field(id, text); }
                save-password => { root.save-kopia-password(); }
            }
        }

        // ── 凭据 ──────────────────────────────────────────────────────────
        RevealItem {
            revealed: root.revealed;
            step: 5;
            bottom: 8px;
            SectionTitle { text: "凭据"; }
        }
        RevealItem {
            revealed: root.revealed;
            step: 6;
            bottom: 24px;
                SyncCredentialsGroup {
                    store-kind: root.store-kind;
                    store-locked: root.store-locked;
                    store-path: root.store-path;
                    master-file: root.master-file;
                    store-name: root.store-name;
                    confirm-master-delete: root.confirm-master-delete;
                    credentials-label: root.credentials-label;
                    master-hint: root.master-hint;
                    can-delete-credentials: root.can-delete-credentials;
                    busy: root.busy;
                    key-id <=> root.key-id;
                    app-key <=> root.app-key;
                    master-password <=> root.master-password;
                    field(id, text) => { root.field(id, text); }
                    save-credentials => { root.save-credentials(); }
                    clear-credentials => { root.clear-credentials(); }
                    unlock => { root.unlock(); }
                    set-master-password => { root.set-master-password(); }
                    lock-credentials => { root.lock-credentials(); }
                    delete-master-requested => { root.delete-master-requested(); }
                    delete-master-cancelled => { root.delete-master-cancelled(); }
                    delete-master-confirmed => { root.delete-master-confirmed(); }
                }
        }

        Rectangle { vertical-stretch: 1; background: #00000000; }
    }
}
