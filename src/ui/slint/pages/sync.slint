// 「云同步」:本机情况 + 连接与保留设置 + 凭据。
// 对应后端 `sync status|set_settings|set_credentials|set_password|unlock|set_master_password|test|now|restore`
// (ADR-012/013:rclone 原生 b2;自动取回只取更新的,手动恢复前先拍快照)。
//
// 可编辑字段的归属与单游戏设置页同一套:页面自己拥有输入框的值,Rust 只在值真的不同时
// 才写回来(见 render.rs)。凭据永远不回显 —— 保存成功后输入框会被清空,而不是填上星号。

import { ScrollView } from "std-widgets.slint";
import { Tokens } from "../theme.slint";
import {
    AccentButton, CardRow, Divider, Group, RevealItem, SectionTitle, StdButton,
    Switch, TextField,
} from "../widgets.slint";

export component SyncPage inherits ScrollView {
    // ── 只读状态(daemon 报什么就显示什么) ────────────────────────────────
    in property <bool> loaded: false;
    in property <string> remote: "";
    in property <string> rclone: "";
    in property <string> keyring: "";
    in property <bool> ephemeral: false;
    in property <string> keyring-hint: "";
    in property <string> problem: "";
    in property <bool> ready: false;
    in property <string> credentials-label: "";
    in property <string> password-hint: "";
    in property <string> master-hint: "";
    in property <int> store-kind: 0;          // 0 系统密钥环 / 1 主密码文件 / 2 仅本次会话
    in property <bool> store-locked: false;
    in property <string> store-path: "";
    in property <bool> has-password: false;
    in property <bool> can-delete-credentials: false;

    // ── 可编辑 ────────────────────────────────────────────────────────────
    // ⚠ 不能叫 `enabled`:ScrollView(std-widgets)自带这个属性名,重名编译器会拒绝。
    in-out property <bool> sync-enabled: false;
    in-out property <string> bucket: "";
    in-out property <string> prefix: "";
    in-out property <string> endpoint: "";
    in-out property <string> keep-versions: "";
    in-out property <bool> encryption: false;
    in property <int> confirm-encryption: 0;   // 0 = 没有待确认, 1 = 待确认开启, 2 = 待确认关闭
    in-out property <string> key-id: "";
    in-out property <string> app-key: "";
    in-out property <string> password: "";
    in-out property <string> password-again: "";
    in-out property <string> master-password: "";

    in property <bool> busy: false;
    in property <string> message: "";
    in property <bool> message-ok: true;

    in-out property <bool> revealed: false;

    callback enabled-toggled(bool);
    callback encryption-toggled(bool);
    // 名字里必须带 clicked:上面已经有同名属性 `confirm-encryption`(int)。
    callback confirm-encryption-clicked();
    callback cancel-encryption-clicked();
    callback field(int, string);
    callback save-settings();
    callback test();
    callback sync-now(string);
    callback restore(string);
    callback restore-confirmed();
    callback restore-cancelled();
    callback save-credentials();
    callback clear-credentials();
    callback save-password();
    callback clear-password();
    callback unlock();
    callback set-master-password();

    Timer { interval: 40ms; running: true; triggered => { root.revealed = true; } }

    VerticalLayout {
        padding-left: root.revealed ? 28px : 68px;
        animate padding-left { duration: 260ms; easing: ease-out; }
        padding-right: 28px;
        padding-top: 12px;
        padding-bottom: 32px;
        spacing: 0px;

        // ── 头 ────────────────────────────────────────────────────────────
        RevealItem {
            revealed: root.revealed;
            step: 0;
            bottom: 20px;
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "云同步"; font-size: 28px; font-weight: 600; color: Tokens.text; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.ready ? "● 已就绪" : (root.problem != "" ? "● 待解决" : "● 未就绪");
                            font-size: 13px;
                            color: root.ready ? Tokens.ok : (root.problem != "" ? Tokens.warn : Tokens.text-3);
                        }
                        Text {
                            text: root.remote;
                            font-size: 13px;
                            color: Tokens.text-3;
                            overflow: elide;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 10px;
                        StdButton {
                            label: "测试连接";
                            button-width: 88px;
                            button-enabled: !root.busy;
                            clicked => { root.test(); }
                        }
                        StdButton {
                            label: "立即同步全部";
                            button-width: 112px;
                            button-enabled: !root.busy;
                            clicked => { root.sync-now(""); }
                        }
                    }
                }
            }
        }

        // ── 本机情况 ──────────────────────────────────────────────────────
        RevealItem {
            revealed: root.revealed;
            step: 1;
            bottom: 8px;
            SectionTitle { text: "本机情况"; }
        }
        RevealItem {
            revealed: root.revealed;
            step: 2;
            bottom: 24px;
            Group {
                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;
                    Text {
                        text: root.loaded ? (root.rclone != "" ? "rclone:" + root.rclone : "rclone 未安装(Arch:sudo pacman -S rclone)") : "读取中…";
                        font-size: 11px;
                        color: root.rclone != "" || !root.loaded ? Tokens.text-3 : Tokens.warn;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "密钥环:" + root.keyring;
                        font-size: 11px;
                        color: root.ephemeral ? Tokens.warn : Tokens.text-3;
                        wrap: word-wrap;
                    }
                    if root.ephemeral : Text {
                        text: "⚠ 本机没有运行中的系统密钥环,填进去的凭据只留在内存里,重启后要重新输入。";
                        font-size: 11px;
                        color: Tokens.warn;
                        wrap: word-wrap;
                    }
                    if root.ephemeral : Text {
                        text: root.keyring-hint;
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                    if root.problem != "" : Text {
                        text: "待解决:" + root.problem;
                        font-size: 11px;
                        color: Tokens.warn;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ── 连接与保留 ────────────────────────────────────────────────────
        RevealItem {
            revealed: root.revealed;
            step: 3;
            bottom: 8px;
            SectionTitle { text: "连接与保留"; }
        }
        RevealItem {
            revealed: root.revealed;
            step: 4;
            bottom: 24px;
            Group {
                CardRow {
                    title: "启用云同步";
                    description: "退出游戏后自动上传存档,启动前自动取回较新的版本。";
                    Switch {
                        checked <=> root.sync-enabled;
                        toggled => { root.enabled-toggled(root.sync-enabled); }
                    }
                }
                Divider { }
                CardRow {
                    title: "bucket";
                    description: "B2 上那个 bucket 的名字。";
                    TextField {
                        field-width: 220px;
                        text <=> root.bucket;
                        edited(text) => { root.field(1, text); }
                        placeholder: "kotori-saves";
                    }
                }
                Divider { }
                CardRow {
                    title: "prefix";
                    description: "bucket 里归 kotori 独占的目录,bucket 里的其他东西我们一律不碰。";
                    TextField {
                        field-width: 220px;
                        text <=> root.prefix;
                        edited(text) => { root.field(2, text); }
                        placeholder: "kotori";
                    }
                }
                Divider { }
                CardRow {
                    title: "API endpoint";
                    description: "留空即可(rclone 会自己找到)。填 s3.<区域>.backblazeb2.com 会被明确拒绝 —— 那对 s3 后端才成立。";
                    TextField {
                        field-width: 220px;
                        text <=> root.endpoint;
                        edited(text) => { root.field(0, text); }
                        placeholder: "留空";
                    }
                }
                Divider { }
                CardRow {
                    title: "保留版本数";
                    description: "0 表示永不删除云端快照;填写后只清理旧快照,绝不动本地存档。";
                    TextField {
                        field-width: 100px;
                        text <=> root.keep-versions;
                        edited(text) => { root.field(3, text); }
                        placeholder: "0";
                    }
                }
                Divider { }
                CardRow {
                    title: "加密上传(rclone crypt)";
                    description: "关闭时存档是明文文件(推荐),任何 S3 工具都能取回;开启后必须记住密码,忘了就打不开自己的备份。";
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        if root.confirm-encryption != 0 : HorizontalLayout {
                            spacing: 8px;
                            StdButton {
                                label: root.confirm-encryption == 1 ? "确认开启" : "确认关闭";
                                button-width: 96px;
                                clicked => { root.confirm-encryption-clicked(); }
                            }
                            StdButton {
                                label: "取消";
                                button-width: 68px;
                                clicked => { root.cancel-encryption-clicked(); }
                            }
                        }
                        Switch {
                            checked <=> root.encryption;
                            toggled => { root.encryption-toggled(root.encryption); }
                        }
                    }
                }
                Divider { }
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    AccentButton {
                        label: "保存设置";
                        button-width: 108px;
                        button-enabled: !root.busy;
                        clicked => { root.save-settings(); }
                    }
                    Text {
                        text: root.message;
                        font-size: 12px;
                        color: root.message-ok ? Tokens.ok : Tokens.danger;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        visible: root.message != "";
                    }
                }
            }
        }

        // ── 凭据 ──────────────────────────────────────────────────────────
        RevealItem {
            revealed: root.revealed;
            step: 5;
            bottom: 8px;
            SectionTitle { text: "凭据"; }
        }
        RevealItem {
            revealed: root.revealed;
            step: 6;
            bottom: 24px;
            Group {
                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;
                    Text {
                        text: "凭据三级存储:系统密钥环 → 主密码加密文件 → 仅本次会话。B2 凭据只保存一套,再次保存即覆盖。";
                        font-size: 12px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.credentials-label;
                        font-size: 11px;
                        color: root.can-delete-credentials ? Tokens.ok : Tokens.warn;
                        wrap: word-wrap;
                    }
                    // 凭据文件锁着的时候,先解锁才谈得上用。
                    if root.store-kind == 1 && root.store-locked : Text {
                        text: "凭据文件已锁定:输入主密码解锁(解锁后本次守护进程内一直有效)。";
                        font-size: 11px;
                        color: Tokens.warn;
                        wrap: word-wrap;
                    }
                    if root.store-kind == 1 && !root.store-locked : Text {
                        text: "✓ 已解锁";
                        font-size: 11px;
                        color: Tokens.ok;
                    }
                    if root.store-kind == 2 : Text {
                        text: "也可以在这里设一个主密码:凭据会用 Argon2id + ChaCha20-Poly1305 加密存到 " + root.store-path + ",之后每次开机只要输一次主密码。密码由你自己保管,我们不会存它。";
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                }
                // 主密码:锁定就解锁,session-only 就设一个。
                if root.store-kind == 1 && root.store-locked : VerticalLayout {
                    Divider { }
                    CardRow {
                        title: "主密码";
                        description: "解锁凭据文件。";
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            TextField {
                                field-width: 220px;
                                password: true;
                                text <=> root.master-password;
                                edited(text) => { root.field(8, text); }
                                placeholder: "凭据文件的主密码";
                            }
                            StdButton {
                                label: "解锁";
                                button-width: 76px;
                                button-enabled: !root.busy;
                                clicked => { root.unlock(); }
                            }
                        }
                    }
                }
                if root.store-kind == 2 : VerticalLayout {
                    Divider { }
                    CardRow {
                        title: "主密码";
                        description: root.master-hint;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            TextField {
                                field-width: 220px;
                                password: true;
                                text <=> root.master-password;
                                edited(text) => { root.field(8, text); }
                                placeholder: "自己记得住就行";
                            }
                            StdButton {
                                label: "加密保存凭据";
                                button-width: 116px;
                                button-enabled: !root.busy;
                                clicked => { root.set-master-password(); }
                            }
                        }
                    }
                }
                Divider { }
                CardRow {
                    title: "keyID";
                    description: "B2 的 Application Key ID(形如 005a…)。";
                    TextField {
                        field-width: 240px;
                        text <=> root.key-id;
                        edited(text) => { root.field(4, text); }
                        placeholder: "Application Key ID";
                    }
                }
                Divider { }
                CardRow {
                    title: "applicationKey";
                    description: "只在创建时显示一次,丢了就再建一个。";
                    TextField {
                        field-width: 240px;
                        password: true;
                        text <=> root.app-key;
                        edited(text) => { root.field(5, text); }
                        placeholder: "只在创建时显示一次";
                    }
                }
                Divider { }
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    StdButton {
                        label: "保存凭据";
                        button-width: 96px;
                        button-enabled: !root.busy;
                        clicked => { root.save-credentials(); }
                    }
                    StdButton {
                        label: "删除凭据";
                        button-width: 96px;
                        button-enabled: !root.busy && root.can-delete-credentials;
                        clicked => { root.clear-credentials(); }
                    }
                    Text {
                        text: "两个框填的都是同一个 B2 账号,下次保存会覆盖上一套";
                        font-size: 11px;
                        color: Tokens.text-3;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                Divider { }
                CardRow {
                    title: "同步密码";
                    description: "仅在开启加密时使用。密码由你自己设定,我们不会替你生成 —— 你从没见过的密码就等于把备份锁在别人手里。";
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        TextField {
                            field-width: 140px;
                            password: true;
                            text <=> root.password;
                            edited(text) => { root.field(6, text); }
                            placeholder: "留空 = 清除密码";
                        }
                        TextField {
                            field-width: 140px;
                            password: true;
                            text <=> root.password-again;
                            edited(text) => { root.field(7, text); }
                            placeholder: "再输一次";
                        }
                        StdButton {
                            label: "保存密码";
                            button-width: 84px;
                            button-enabled: !root.busy;
                            clicked => { root.save-password(); }
                        }
                        StdButton {
                            label: "删除密码";
                            button-width: 84px;
                            button-enabled: !root.busy && root.has-password;
                            clicked => { root.clear-password(); }
                        }
                    }
                }
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 14px;
                    spacing: 4px;
                    Text {
                        text: "密码状态:" + (root.has-password ? "已保存在密钥环(改密码会让已加密上传的存档无法解密,会再确认一次)" : "未设置(没开加密就不需要它)");
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "忘了也能自己取回来:" + root.password-hint;
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; background: #00000000; }
    }
}
