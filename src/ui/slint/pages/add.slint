// 「添加游戏」:只有手动填写 —— kotori 不做目录扫描(那个只存在于 CLI 的 `kotori scan`,
// 管理器里没有这个功能,也不打算加)。字段顺序照填写流程排:先是可执行文件,然后
// 游戏根目录,游戏名放最后(调整前是:游戏名 / 游戏根目录 / 可执行文件)。
//
// exe 一落定就去云端认这一款(用户 2026-09-23 定:exe 是唯一必填项,认出来就在本页直接
// 确定)。那一块的状态放在 `AddMatchBoard` 全局里(照 `CloudBoard`/`PairingBoard` 的先例):
// 页面只管画,窗口不必替它转发一串属性与回调。⚠ 那一块**永远不挡添加**。
//
// 指纹认不出时还有一条路:「自己选…」——从云端清单里挑一条绑上(`CloudPickerState`)。

import { ScrollView } from "std-widgets.slint";
import { Tokens } from "../theme.slint";
import { Divider, RevealItem } from "../widgets/base.slint";
import { PathField } from "../widgets/path-field.slint";
import { TextField } from "../widgets/controls.slint";
import { AccentButton, StdButton } from "../widgets/buttons.slint";
import { ProcessPickerState } from "../widgets/process-picker.slint";
import { CloudPickerState } from "../widgets/cloud-picker.slint";
import { CardRow, Group, SectionTitle } from "../widgets/card.slint";
import { AddMatchItem } from "../types.slint";

export global AddMatchBoard {
    /// 要不要说点什么(exe 还没落到一个真实文件上时什么都不说,免得一进页面就闪)。
    in-out property <bool> visible: false;
    /// 一句话标题(Rust 那边按"还没建索引 / 云端确实没有 / 问不成"分别措辞)。
    in-out property <string> title: "";
    /// 标题下面那行小字(可以多行)。
    in-out property <string> detail: "";
    /// 这句话是正常信息还是"没问成"(没问成时灰着说,不吓人 —— 它不影响添加)。
    in-out property <bool> ok: true;
    /// 正在问云端。
    in-out property <bool> busy: false;
    /// 指纹命中的候选:**只有多条时才列出来**让用户挑(唯一命中直接写在标题里)。
    in-out property <[AddMatchItem]> rows: [];
    /// 用户已经点了「不是这一款」。
    in-out property <bool> declined: false;
    /// 一个候选都没有时(云端没有这一款 / 还没建索引 / 没问成)「不是这一款」没有意义
    /// —— 那按钮该藏起来,留给「自己选…」。
    in-out property <bool> can-decline: false;
    /// 用户已经从云端清单里自己选了一条(这时才给「改回自动」)。
    in-out property <bool> picked: false;

    callback choose(string);
    callback decline();
    callback restore();
    callback clear-pick();
}

export component AddPage inherits ScrollView {
    // 见 `games.slint` 里的长注释:fluent 默认关掉拖拽滚动,没有滚轮的机器要靠这一行。
    mouse-drag-pan-enabled: true;
    in-out property <bool> revealed: false;
    in-out property <string> new-name: "";
    in-out property <string> new-game-dir: "";
    in-out property <string> new-exe: "";
    in property <bool> creating: false;
    // 成功与失败都走这一行(Rust 决定措辞):空串表示还没动作。
    in property <string> message: "";
    in property <bool> message-ok: true;
    // 「浏览…」:系统里有没有可用的文件对话框,以及没有时的理由。
    in property <bool> browse-enabled: true;
    in property <string> path-hint: "";

    callback name-changed(string);
    callback game-dir-changed(string);
    callback exe-changed(string);
    callback browse-game-dir();
    callback browse-exe();
    callback create-requested();

    Timer { interval: 40ms; running: true; triggered => { root.revealed = true; } }

    VerticalLayout {
        padding-left: root.revealed ? 28px : 68px;
        animate padding-left { duration: 260ms; easing: ease-out; }
        padding-right: 28px;
        padding-top: 12px;
        padding-bottom: 32px;
        spacing: 0px;

        RevealItem {
            revealed: root.revealed;
            step: 0;
            bottom: 20px;
            VerticalLayout {
                spacing: 4px;
                Text { text: "添加游戏"; font-size: 28px; font-weight: 600; color: Tokens.text; }
                Text {
                    text: "手动填写。选好可执行文件之后,下面的根目录与游戏名会自动填好(每点一次「浏览…」都会跟着更新),不合适就地改。";
                    font-size: 14px;
                    color: Tokens.text-3;
                }
            }
        }

        RevealItem {
            revealed: root.revealed;
            step: 1;
            bottom: 8px;
            SectionTitle { text: "新建条目"; }
        }
        RevealItem {
            revealed: root.revealed;
            step: 2;
            bottom: 24px;
            Group {
                CardRow {
                    title: "从正在运行的进程添加";
                    description: "游戏开着的时候直接挑它:名字、可执行文件与根目录会替你填好,确认后点「添加游戏」。";
                    StdButton {
                        label: "挑选进程…";
                        button-width: 104px;
                        clicked => { ProcessPickerState.pick-for-new-game(); }
                    }
                }
                Divider { }
                CardRow {
                    title: "可执行文件";
                    description: "exe 的完整路径。选完这里,下面两项会自动填。";
                    PathField {
                        field-width: 340px;
                        text <=> root.new-exe;
                        edited(text) => { root.exe-changed(text); }
                        browse-enabled: root.browse-enabled;
                        browse-clicked => { root.browse-exe(); }
                        placeholder: "/path/to/game.exe";
                    }
                }
                Divider { }
                // ── 云端匹配 ────────────────────────────────────────────────
                // exe 落到一个真实文件上之后才出现。**它只影响"要不要顺手绑上"**:
                // 问不成 / 云端没有 / 用户说"不是这一款",添加照旧。
                if AddMatchBoard.visible : VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    Text {
                        text: AddMatchBoard.title;
                        font-size: 13px;
                        font-weight: 600;
                        color: AddMatchBoard.ok ? Tokens.accent : Tokens.text-3;
                        wrap: word-wrap;
                    }
                    if AddMatchBoard.detail != "" : Text {
                        text: AddMatchBoard.detail;
                        font-size: 12px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                    // 指纹命中多条时才列(唯一命中直接写在标题里,不让人多点一下)。
                    for row[index] in AddMatchBoard.rows : VerticalLayout {
                        spacing: 2px;
                        StdButton {
                            label: row.chosen ? "✓ " + row.label : row.label;
                            button-width: 360px;
                            clicked => { AddMatchBoard.choose(row.cloud-id); }
                        }
                        if row.detail != "" : Text {
                            text: row.detail;
                            font-size: 11px;
                            color: Tokens.text-3;
                            wrap: word-wrap;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        // 「自己选…」**一直在**:指纹没命中、命中多条、甚至根本没问成时,
                        // 用户自己知道云端那一条叫什么(用户 2026-09-23 要的)。
                        StdButton {
                            label: "自己选…";
                            button-width: 92px;
                            clicked => { CloudPickerState.open-for-add(); }
                        }
                        // 「不是这一款」只在一个候选都没有时**不该出现** —— 那时它按下去
                        // 什么也没改变(可以否决的才有"不是这一款"这回事)。
                        if AddMatchBoard.can-decline : StdButton {
                            label: "不是这一款";
                            button-width: 110px;
                            clicked => { AddMatchBoard.decline(); }
                        }
                        if AddMatchBoard.declined : StdButton {
                            label: "改主意，绑上";
                            button-width: 110px;
                            clicked => { AddMatchBoard.restore(); }
                        }
                        // 自己选过之后给一条退路:回到指纹匹配的结果。
                        if AddMatchBoard.picked : StdButton {
                            label: "改回自动";
                            button-width: 92px;
                            clicked => { AddMatchBoard.clear-pick(); }
                        }
                        Rectangle { horizontal-stretch: 1; background: #00000000; }
                    }
                    // 这一块自带收尾的分隔线:否则"没有匹配"时上下两个 Divider 会挨在
                    // 一起,画出一条双线(那看起来像卡片被切了一刀)。
                    Divider { }
                }
                CardRow {
                    title: "游戏根目录";
                    description: "启动时的工作目录,也是 relative 存档路径的基准。留空 = 取 exe 所在目录。";
                    PathField {
                        field-width: 340px;
                        text <=> root.new-game-dir;
                        edited(text) => { root.game-dir-changed(text); }
                        browse-enabled: root.browse-enabled;
                        browse-clicked => { root.browse-game-dir(); }
                        placeholder: "/path/to/game";
                    }
                }
                Divider { }
                CardRow {
                    title: "游戏名";
                    description: "库里显示的名字。留空 = 取 exe 的文件名(去掉扩展名)。";
                    TextField {
                        field-width: 300px;
                        text <=> root.new-name;
                        edited(text) => { root.name-changed(text); }
                        placeholder: "例如 3days";
                    }
                }
                if root.path-hint != "" : VerticalLayout {
                    Divider { }
                    VerticalLayout {
                        padding: 12px;
                        Text {
                            text: root.path-hint;
                            font-size: 11px;
                            color: Tokens.text-3;
                            wrap: word-wrap;
                        }
                    }
                }
                Divider { }
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    AccentButton {
                        label: root.creating ? "添加中…" : "添加游戏";
                        button-width: 108px;
                        button-enabled: !root.creating;
                        clicked => { root.create-requested(); }
                    }
                    Text {
                        text: root.message;
                        font-size: 12px;
                        color: root.message-ok ? Tokens.ok : Tokens.danger;
                        vertical-alignment: center;
                        visible: root.message != "";
                    }
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                }
            }
        }

        RevealItem {
            revealed: root.revealed;
            step: 3;
            bottom: 0px;
            Group {
                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;
                    Text {
                        text: "添加之后";
                        font-size: 14px;
                        font-weight: 600;
                        color: Tokens.text;
                    }
                    Text {
                        text: "回到游戏库点这一行,就能继续配置缩放倍数 / 算法 / 锐度,以及这个游戏自己的存档位置。";
                        font-size: 12px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; background: #00000000; }
    }
}
