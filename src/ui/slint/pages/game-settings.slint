// 单个游戏的设置页:从游戏库点某一行进来,左上角返回。
//
// 内容对齐后端的 `GameConfig`(见 src/config/profile.rs):
// 路径 / 缩放档(算法、锐度、分辨率、比例、全屏、帧率) / 存档位置(三形态 + 排除)。
//
// ── 这里的状态归属,值得先看懂再改 ──────────────────────────────────────────
// Slint 里的 `in-out` 属性就是"这一层自己拥有的值"。可编辑的字段**必须是页面自己拥有**的:
// 若把输入框绑到窗口属性上,用户一敲键就会把那根绑定打断(Slint 的赋值会移除绑定)。
// 所以分成两份:
//   · `stored`(Rust 推的已存值)+ `seed` 令牌 —— 只在进页面 / 重置 / 保存成功后变,用来**抄**一份副本;
//   · 页面自己的 `in-out` 副本 —— 用户改的是它,每次改动立刻上报 Rust(草稿在 Rust 那边)。
// Rust **不会**在每次刷新时把草稿推回来(只有 `seed` 变了才抄),否则每敲一个字输入框就被重置。

import { ScrollView } from "std-widgets.slint";
import { Tokens } from "../theme.slint";
import {
    AccentButton, CardRow, Divider, DropdownList, Group, IconButton, RevealItem,
    SectionTitle, Select, Slider, StdButton, Switch, TextField,
} from "../widgets.slint";
import { GameItem, GameDetail, SaveItem } from "../types.slint";

// 一行存档位置:类型(三种形态)+ 路径 + 排除规则 + 删除。
// 类型是拽不动的下拉 —— 浮层统一由页面画(见文件末尾),所以这里只上报锚点。
component SaveRow inherits Rectangle {
    in property <int> kind;
    in property <string> path;
    in property <string> exclude;
    in property <string> placeholder: "存放路径";
    in property <bool> open: false;
    in property <[string]> kinds;
    callback kind-clicked(Point);
    callback path-changed(string);
    callback exclude-changed(string);
    callback remove-clicked();

    height: layout.preferred-height;
    background: #00000000;

    layout := HorizontalLayout {
        padding: 10px;
        spacing: 8px;

        sel := Select {
            select-width: 118px;
            options: root.kinds;
            selected: root.kind;
            open: root.open;
            toggled => { root.kind-clicked(sel.absolute-position); }
        }

        TextField {
            horizontal-stretch: 1;
            field-width: 220px;
            text: root.path;
            placeholder: root.placeholder;
            edited(text) => { root.path-changed(text); }
        }

        TextField {
            field-width: 170px;
            text: root.exclude;
            placeholder: "排除:*.log, cache/";
            edited(text) => { root.exclude-changed(text); }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: "\u{E74D}";
                icon-size: 13px;
                clicked => { root.remove-clicked(); }
            }
        }
    }
}

export component GameSettingsPage inherits Rectangle {
    // 会话状态(是否在跑)→ 由 Rust 每次刷新推,所以这里读的是实时值。
    in property <GameItem> game;
    // 已存值 + 抄写令牌。
    in property <GameDetail> stored;
    in property <int> seed: 0;
    in property <[SaveItem]> saves;
    in property <[string]> algo-options;
    in property <[string]> save-kinds;
    in property <bool> show-sharpness: true;
    in property <bool> saving: false;
    in property <string> saved-msg: "";
    in property <bool> saved-ok: true;
    in property <bool> confirm-delete: false;
    // 云存档:这一款游戏的状况与两个动作(措辞由 Rust 拼,见 render.rs 的 sync_line)
    in property <string> sync-line: "";
    in property <bool> sync-can-act: false;
    in property <bool> sync-pending: false;
    in property <bool> sync-busy: false;

    callback back();
    callback launch();
    callback save();
    callback reset();
    callback delete-requested();
    callback delete-cancelled();
    callback delete-confirmed();

    callback game-dir-changed(string);
    callback exe-changed(string);
    callback ratio-changed(string);
    callback algo-picked(int);
    callback sharpness-changed(int);
    callback internal-w-changed(string);
    callback internal-h-changed(string);
    callback output-w-changed(string);
    callback output-h-changed(string);
    callback fullscreen-toggled(bool);
    callback framerate-changed(string);

    callback add-save();
    callback remove-save(int);
    callback save-kind-picked(int, int);
    callback save-path-changed(int, string);
    callback save-exclude-changed(int, string);
    callback sync-now();
    callback sync-restore();
    callback sync-restore-confirmed();
    callback sync-restore-cancelled();

    in-out property <bool> revealed: false;
    in-out property <int> open-select: -1;                      // 0 = 缩放算法
    in-out property <int> open-save: -1;                        // 打开下拉的存档行下标
    in-out property <int> open-save-kind: 0;
    in-out property <Point> save-anchor: { x: 0px, y: 0px };

    // ── 可编辑副本(见文件头) ───────────────────────────────────────────────
    in-out property <string> game-dir: "";
    in-out property <string> exe-path: "";
    in-out property <string> ratio: "";
    in-out property <int> algo-index: 0;
    in-out property <int> sharpness: 0;
    in-out property <string> internal-w: "";
    in-out property <string> internal-h: "";
    in-out property <string> output-w: "";
    in-out property <string> output-h: "";
    in-out property <bool> fullscreen: false;
    in-out property <string> framerate: "";

    function seed-copy() {
        root.game-dir = root.stored.game-dir;
        root.exe-path = root.stored.exe;
        root.ratio = root.stored.ratio;
        root.algo-index = root.stored.algo;
        root.sharpness = root.stored.sharpness;
        root.internal-w = root.stored.internal-w;
        root.internal-h = root.stored.internal-h;
        root.output-w = root.stored.output-w;
        root.output-h = root.stored.output-h;
        root.fullscreen = root.stored.fullscreen;
        root.framerate = root.stored.framerate;
    }

    init => { root.seed-copy(); }
    changed seed => { root.seed-copy(); }

    background: #00000000;
    Timer { interval: 40ms; running: true; triggered => { root.revealed = true; } }

    ScrollView {
        VerticalLayout {
            padding-left: root.revealed ? 28px : 68px;
            animate padding-left { duration: 260ms; easing: ease-out; }
            padding-right: 28px;
            padding-top: 12px;
            padding-bottom: 32px;
            spacing: 0px;

            // ── 头部:返回 + 游戏名 + 动作 ──────────────────────────────
            RevealItem {
                revealed: root.revealed;
                step: 0;
                bottom: 20px;
                HorizontalLayout {
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            glyph: "\u{E72B}";
                            icon-size: 14px;
                            clicked => { root.back(); }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.game.name + "  ·  " + root.game.exe;
                            font-size: 18px;
                            font-weight: 600;
                            color: Tokens.text;
                            overflow: elide;
                        }
                        Text {
                            text: "每次修改保存后,重新启动游戏即生效。";
                            font-size: 12px;
                            color: Tokens.text-3;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.game.state == 1 ? "● 运行中" : (root.game.state == 2 ? "● 仅观测" : "未运行");
                            font-size: 12px;
                            color: root.game.state == 1 ? Tokens.ok : (root.game.state == 2 ? Tokens.warn : Tokens.text-3);
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        AccentButton {
                            label: root.game.state != 0
                                ? "停止"
                                : (root.game.launching ? "启动中…" : (root.game.watch-only ? "监视" : "启动"));
                            button-width: 96px;
                            button-enabled: !root.game.launching;
                            clicked => { root.launch(); }
                        }
                    }
                }
            }

            // ── 路径 ──────────────────────────────────────────────────
            RevealItem {
                revealed: root.revealed;
                step: 1;
                bottom: 8px;
                SectionTitle { text: "路径"; }
            }
            RevealItem {
                revealed: root.revealed;
                step: 2;
                bottom: 24px;
                Group {
                    CardRow {
                        title: "游戏根目录";
                        description: "启动时的 CWD,也是 relative 存档路径的基准。";
                        TextField {
                            field-width: 340px;
                            text <=> root.game-dir;
                            edited(text) => { root.game-dir-changed(text); }
                            placeholder: "/path/to/game";
                        }
                    }
                    Divider { }
                    CardRow {
                        title: "可执行文件";
                        description: "exe 的完整路径。";
                        TextField {
                            field-width: 340px;
                            text <=> root.exe-path;
                            edited(text) => { root.exe-changed(text); }
                            placeholder: "/path/to/game.exe";
                        }
                    }
                }
            }

            // ── 仅观测(只有这类游戏才需要说) ────────────────────────────
            if root.game.watch-only : VerticalLayout {
                RevealItem {
                    revealed: root.revealed;
                    step: 2;
                    bottom: 8px;
                    SectionTitle { text: "仅观测"; }
                }
                RevealItem {
                    revealed: root.revealed;
                    step: 2;
                    bottom: 24px;
                    Group {
                        CardRow {
                            title: "跟随进程";
                            description: "这个游戏由你自己启动(快捷方式 / 启动器都行),kotori 不替它开 gamescope、也不做缩放,只盯着这个进程;它退出后收尾并照常上传存档。";
                            Text {
                                text: root.game.process == "" ? "（未设置进程名,按 exe 文件名认）" : root.game.process;
                                font-size: 13px;
                                color: Tokens.text-2;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // ── 缩放 ──────────────────────────────────────────────────
            RevealItem {
                revealed: root.revealed;
                step: 3;
                bottom: 8px;
                SectionTitle { text: "缩放"; }
            }
            RevealItem {
                revealed: root.revealed;
                step: 4;
                bottom: 24px;
                Group {
                    CardRow {
                        title: "缩放倍数";
                        description: "输出像素 ÷ 游戏分辨率。留空则沿用输出分辨率。";
                        TextField {
                            field-width: 120px;
                            text <=> root.ratio;
                            edited(text) => { root.ratio-changed(text); }
                            placeholder: "例如 1.75";
                        }
                    }
                    Divider { }
                    CardRow {
                        title: "缩放算法";
                        description: "决定画面放大的方式。";
                        algo := Select {
                            options: root.algo-options;
                            selected: root.algo-index;
                            open: root.open-select == 0;
                            toggled => { root.open-select = root.open-select == 0 ? -1 : 0; }
                        }
                    }
                    if root.show-sharpness : VerticalLayout {
                        Divider { }
                        CardRow {
                            title: "锐度";
                            description: "只有 FSR / NIS 有效,越大越锐(0–5)。";
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: center;
                                Slider {
                                    track-width: 200px;
                                    max: 5;
                                    value <=> root.sharpness;
                                }
                                Text {
                                    text: root.sharpness + " / 5";
                                    font-size: 13px;
                                    color: Tokens.text-2;
                                    vertical-alignment: center;
                                    min-width: 34px;
                                }
                            }
                        }
                    }
                    Divider { }
                    CardRow {
                        title: "全屏启动";
                        description: "铺满整块显示器。会盖掉上面的缩放倍数(-f 让 g_nOutput 变成屏幕尺寸)。";
                        Switch {
                            checked <=> root.fullscreen;
                            toggled => { root.fullscreen-toggled(root.fullscreen); }
                        }
                    }
                    Divider { }
                    CardRow {
                        title: "游戏分辨率";
                        description: "游戏自己渲染的尺寸,由 gamescope 的 -w/-h 传入。";
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;
                            TextField {
                                field-width: 88px;
                                text <=> root.internal-w;
                                edited(text) => { root.internal-w-changed(text); }
                            }
                            Text { text: "×"; font-size: 13px; color: Tokens.text-3; vertical-alignment: center; }
                            TextField {
                                field-width: 88px;
                                text <=> root.internal-h;
                                edited(text) => { root.internal-h-changed(text); }
                            }
                        }
                    }
                    Divider { }
                    CardRow {
                        title: "输出分辨率";
                        description: "窗口实际开多大。填了缩放倍数时它只作参考。";
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;
                            TextField {
                                field-width: 88px;
                                text <=> root.output-w;
                                edited(text) => { root.output-w-changed(text); }
                            }
                            Text { text: "×"; font-size: 13px; color: Tokens.text-3; vertical-alignment: center; }
                            TextField {
                                field-width: 88px;
                                text <=> root.output-h;
                                edited(text) => { root.output-h-changed(text); }
                            }
                        }
                    }
                    Divider { }
                    CardRow {
                        title: "帧率限制";
                        description: "留空表示不限。";
                        TextField {
                            field-width: 100px;
                            text <=> root.framerate;
                            edited(text) => { root.framerate-changed(text); }
                            placeholder: "60";
                        }
                    }
                }
            }

            // 旧 iced 版就把这三条写在详情页里,用户看得到的地方不留玄学。
            RevealItem {
                revealed: root.revealed;
                step: 5;
                bottom: 20px;
                VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: "缩放倍数 = 输出像素 ÷ 游戏自身分辨率,填了它就以它为准(输出分辨率宽/高只作参考)。启动游戏时按这个倍数开窗,快捷键「按设定比例缩放／取消缩放」(默认 Shift+Alt+Q)也是在这个倍数和 1:1 之间来回切。";
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "平铺桌面(niri)下游戏窗口铺满整块显示器,窗口尺寸不由 kotori 决定,输出分辨率只影响缩放计算;KDE 上窗口缩放走 KWin。窗口聚焦时也能用 gamescope 自带热键实时切:Super+U FSR、Super+Y NIS、Super+N 最近邻、Super+I/O 锐度增/减。";
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                }
            }

            // ── 存档位置 ──────────────────────────────────────────────
            RevealItem {
                revealed: root.revealed;
                step: 6;
                bottom: 8px;
                SectionTitle { text: "存档位置"; }
            }
            RevealItem {
                revealed: root.revealed;
                step: 7;
                bottom: 24px;
                Group {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 4px;
                        Text {
                            text: "windows = prefix 里的 Windows 路径,推荐用 %APPDATA% / %DOCUMENTS% 这类令牌(别写用户名,各 prefix 不一样);relative = 相对游戏根目录;absolute = 只在这台机器上有效,不跨平台同步。";
                            font-size: 12px;
                            color: Tokens.text-3;
                            wrap: word-wrap;
                        }
                    }
                    Divider { }
                    for entry[index] in root.saves : SaveRow {
                        kind: entry.kind;
                        path: entry.path;
                        exclude: entry.exclude;
                        placeholder: entry.placeholder;
                        kinds: root.save-kinds;
                        open: root.open-save == index;
                        kind-clicked(anchor) => {
                            root.open-save = index;
                            root.open-save-kind = entry.kind;
                            root.save-anchor = anchor;
                        }
                        path-changed(text) => { root.save-path-changed(index, text); }
                        exclude-changed(text) => { root.save-exclude-changed(index, text); }
                        remove-clicked => { root.remove-save(index); }
                    }
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;
                        StdButton {
                            label: "添加存档位置";
                            button-width: 130px;
                            clicked => { root.add-save(); }
                        }
                        Rectangle { horizontal-stretch: 1; background: #00000000; }
                    }
                }
            }

            // ── 云存档(只谈这一款) ─────────────────────────────────────
            // 以前这些行在「云同步」页里一次列全部游戏,游戏一多那页就没法看了。
            RevealItem {
                revealed: root.revealed;
                step: 8;
                bottom: 8px;
                SectionTitle { text: "云存档"; }
            }
            RevealItem {
                revealed: root.revealed;
                step: 8;
                bottom: 24px;
                Group {
                    CardRow {
                        title: "这一款的同步";
                        description: root.sync-line;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            if root.sync-can-act && root.sync-pending : HorizontalLayout {
                                spacing: 8px;
                                StdButton {
                                    label: "确认恢复(会覆盖本地存档)";
                                    button-width: 196px;
                                    button-enabled: !root.sync-busy;
                                    clicked => { root.sync-restore-confirmed(); }
                                }
                                StdButton {
                                    label: "取消";
                                    button-width: 68px;
                                    clicked => { root.sync-restore-cancelled(); }
                                }
                            }
                            if root.sync-can-act && !root.sync-pending : HorizontalLayout {
                                spacing: 8px;
                                StdButton {
                                    label: "立即同步";
                                    button-width: 92px;
                                    button-enabled: !root.sync-busy;
                                    clicked => { root.sync-now(); }
                                }
                                StdButton {
                                    label: "恢复";
                                    button-width: 76px;
                                    button-enabled: !root.sync-busy;
                                    clicked => { root.sync-restore(); }
                                }
                            }
                        }
                    }
                    Divider { }
                    VerticalLayout {
                        padding: 16px;
                        spacing: 4px;
                        Text {
                            text: "「立即同步」= 把这款游戏的存档立刻传上去(游戏退出后本来就会自动传);「恢复」= 用云端最新的那份覆盖本地 —— 覆盖前 kotori 会先替本地拍一份快照,所以这一步是可撤销的。";
                            font-size: 11px;
                            color: Tokens.text-3;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // ── 底部动作 ──────────────────────────────────────────────
            RevealItem {
                revealed: root.revealed;
                step: 8;
                bottom: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    AccentButton {
                        label: root.saving ? "保存中…" : "保存配置";
                        button-width: 108px;
                        button-enabled: !root.saving;
                        clicked => { root.save(); }
                    }
                    StdButton {
                        label: "重置";
                        button-width: 84px;
                        clicked => { root.reset(); }
                    }
                    Text {
                        text: root.saved-msg;
                        font-size: 12px;
                        color: root.saved-ok ? Tokens.ok : Tokens.danger;
                        vertical-alignment: center;
                        visible: root.saved-msg != "";
                    }
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                }
            }

            RevealItem {
                revealed: root.revealed;
                step: 9;
                bottom: 0px;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "删除这个条目?(不会删除游戏文件)";
                        font-size: 12px;
                        color: Tokens.danger;
                        vertical-alignment: center;
                        visible: root.confirm-delete;
                    }
                    StdButton {
                        label: root.confirm-delete ? "确认删除" : "删除条目";
                        button-width: 108px;
                        clicked => {
                            if (root.confirm-delete) { root.delete-confirmed(); }
                            else { root.delete-requested(); }
                        }
                    }
                    if root.confirm-delete : StdButton {
                        label: "取消";
                        button-width: 76px;
                        clicked => { root.delete-cancelled(); }
                    }
                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                }
            }

            Rectangle { vertical-stretch: 1; background: #00000000; }
        }
    }

    // 点空白处收起
    if root.open-select >= 0 || root.open-save >= 0 : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000000;
        TouchArea {
            clicked => { root.open-select = -1; root.open-save = -1; }
        }
    }

    // 浮层画在 ScrollView 之外,所以不会被视口裁掉、也盖得住下面的卡片。
    if root.open-select == 0 : DropdownList {
        x: algo.absolute-position.x - root.absolute-position.x;
        y: algo.absolute-position.y - root.absolute-position.y + algo.height + 4px;
        width: algo.width;
        options: algo.options;
        selected: root.algo-index;
        picked(index) => {
            root.algo-index = index;
            root.open-select = -1;
            root.algo-picked(index);
        }
    }

    // 存档行的下拉:锚点是那行 Select 自己报上来的 absolute-position。
    if root.open-save >= 0 : DropdownList {
        x: root.save-anchor.x - root.absolute-position.x;
        y: root.save-anchor.y - root.absolute-position.y + 36px;
        width: 178px;
        options: root.save-kinds;
        selected: root.open-save-kind;
        picked(index) => {
            root.save-kind-picked(root.open-save, index);
            root.open-save = -1;
        }
    }
}
