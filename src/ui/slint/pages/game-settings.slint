// 单个游戏的设置页:从游戏库点某一行进来,左上角返回。
//
// 内容对齐后端的 `GameConfig`(见 src/config/profile.rs):
// 路径 / 缩放档(算法、锐度、分辨率、比例、全屏、帧率) / 存档位置(三形态 + 排除)。
//
// ── 这里的状态归属,值得先看懂再改 ──────────────────────────────────────────
// Slint 里的 `in-out` 属性就是"这一层自己拥有的值"。可编辑的字段**必须是页面自己拥有**的:
// 若把输入框绑到窗口属性上,用户一敲键就会把那根绑定打断(Slint 的赋值会移除绑定)。
// 所以分成两份:
//   · `stored`(Rust 推的已存值)+ `seed` 令牌 —— 只在进页面 / 重置 / 保存成功后变,用来**抄**一份副本;
//   · 页面自己的 `in-out` 副本 —— 用户改的是它,每次改动立刻上报 Rust(草稿在 Rust 那边)。
// Rust **不会**在每次刷新时把草稿推回来(只有 `seed` 变了才抄),否则每敲一个字输入框就被重置。

import { ScrollView } from "std-widgets.slint";
import { Tokens } from "../theme.slint";
import { Divider, IconButton, RevealItem } from "../widgets/base.slint";
import { Slider, Switch, TextField } from "../widgets/controls.slint";
import { PathField } from "../widgets/path-field.slint";
import { DropdownList, Select } from "../widgets/select.slint";
import { AccentButton, StdButton } from "../widgets/buttons.slint";
import { CardRow, Group, SectionTitle } from "../widgets/card.slint";
import { GameItem, GameDetail, PathPick, SaveItem } from "../types.slint";
import { GameSavesGroup } from "game-saves.slint";
import { GameHeader } from "game-header.slint";
import { GameActions } from "game-actions.slint";
import { GameLaunchGroup } from "game-launch.slint";
import { GameScaleAdvancedGroup, GameScaleGroup } from "game-scale.slint";
import { GameSyncGroup } from "game-sync.slint";



export component GameSettingsPage inherits Rectangle {
    // 会话状态(是否在跑)→ 由 Rust 每次刷新推,所以这里读的是实时值。
    in property <GameItem> game;
    // 启动方式(直接启动)与自动追踪,由 render 从草稿推;Switch 只上报"用户点了"。
    // ⚠ 两者**互不相干**:追踪说的是"别人启动的那一局也要跟",不是一种启动方式
    // (用户 2026-09-20 纠正:仅观测是**状态**,不该拿来当开关的名字)。
    in property <bool> game-direct-launch;
    in property <bool> game-auto-watch;
    // 已存值 + 抄写令牌。
    in property <GameDetail> stored;
    in property <int> seed: 0;
    in property <[SaveItem]> saves;
    in property <[string]> algo-options;
    in property <[string]> save-kinds;
    in property <bool> show-sharpness: true;
    in property <bool> saving: false;
    in property <string> saved-msg: "";
    in property <bool> saved-ok: true;
    in property <bool> confirm-delete: false;
    // 「停止」的二次确认(只在**会杀进程**的那一局为真,见 `update::run`)。
    in property <bool> confirm-stop: false;
    // 云存档:这一款游戏的状况与两个动作(措辞由 Rust 拼,见 render.rs 的 sync_line)
    in property <string> sync-line: "";
    in property <bool> sync-can-act: false;
    in property <bool> sync-pending: false;
    in property <bool> sync-busy: false;
    // 「浏览…」:系统里有没有可用的文件对话框(没有就灰掉按钮),以及没有时的理由。
    in property <bool> browse-enabled: true;
    in property <string> path-hint: "";
    // 刚挑回来的值:窗口只能推一个令牌过来,填哪个框由**这一页**决定(见 types.slint)。
    in property <PathPick> path-pick: { token: 0, target: -1, value: "" };

    callback back();
    callback toggle-run();
    callback reset();
    callback delete-requested();
    callback delete-cancelled();
    callback delete-confirmed();
    callback direct-launch-toggled(bool);
    callback auto-watch-toggled(bool);
    callback process-name-changed(string);
    callback stop-cancelled();

    callback game-dir-changed(string);
    callback exe-changed(string);
    callback launch-args-changed(string);
    callback browse-game-dir();
    callback browse-exe();
    callback browse-save(int);
    callback ratio-changed(string);
    callback algo-picked(int);
    callback sharpness-changed(int);
    callback internal-w-changed(string);
    callback internal-h-changed(string);
    callback output-w-changed(string);
    callback output-h-changed(string);
    callback fullscreen-toggled(bool);
    callback framerate-changed(string);
    callback gamescope-args-changed(string);

    callback add-save();
    callback remove-save(int);
    callback save-kind-picked(int, int);
    callback save-path-changed(int, string);
    callback save-exclude-changed(int, string);
    callback sync-now();
    callback sync-restore();
    callback sync-restore-confirmed();
    callback sync-restore-cancelled();

    in-out property <bool> revealed: false;
    in-out property <int> open-select: -1;                      // 0 = 缩放算法
    in-out property <int> open-save: -1;                        // 打开下拉的存档行下标
    in-out property <int> open-save-kind: 0;
    in-out property <Point> save-anchor: { x: 0px, y: 0px };
    in-out property <Point> algo-anchor: { x: 0px, y: 0px };

    // ── 可编辑副本(见文件头) ───────────────────────────────────────────────
    in-out property <string> game-dir: "";
    in-out property <string> exe-path: "";
    // exe 的额外参数(一行文本,存的时候按空白切成 argv)。
    in-out property <string> launch-args: "";
    in-out property <string> ratio: "";
    in-out property <int> algo-index: 0;
    in-out property <int> sharpness: 0;
    in-out property <string> internal-w: "";
    in-out property <string> internal-h: "";
    in-out property <string> output-w: "";
    in-out property <string> output-h: "";
    in-out property <bool> fullscreen: false;
    in-out property <string> framerate: "";
    // 手写的 gamescope 参数;非空时档案里其它缩放设置全部让位。
    in-out property <string> gamescope-args: "";
    // 自动追踪盯的进程名(存配置);空 = 按 exe 文件名认。
    in-out property <string> process-name: "";

    function seed-copy() {
        root.game-dir = root.stored.game-dir;
        root.exe-path = root.stored.exe;
        root.launch-args = root.stored.launch-args;
        root.ratio = root.stored.ratio;
        root.algo-index = root.stored.algo;
        root.sharpness = root.stored.sharpness;
        root.internal-w = root.stored.internal-w;
        root.internal-h = root.stored.internal-h;
        root.output-w = root.stored.output-w;
        root.output-h = root.stored.output-h;
        root.fullscreen = root.stored.fullscreen;
        root.framerate = root.stored.framerate;
        root.gamescope-args = root.stored.gamescope-args;
        root.process-name = root.stored.process-name;
    }

    init => { root.seed-copy(); }
    changed seed => { root.seed-copy(); }

    // 「浏览…」挑回来的值:只填那一个框(别的一个都不碰 —— 用户手上可能还有
    // 半截没改完的输入)。`token` 每次都变,所以同一个路径再挑一次也会触发。
    changed path-pick => {
        if root.path-pick.target == 0 { root.game-dir = root.path-pick.value; }
        if root.path-pick.target == 1 { root.exe-path = root.path-pick.value; }
    }

    background: #00000000;
    Timer { interval: 40ms; running: true; triggered => { root.revealed = true; } }

    ScrollView {
        // 见 `games.slint` 里的长注释:fluent 默认关掉拖拽滚动,没有滚轮的机器要靠这一行。
        mouse-drag-pan-enabled: true;
        VerticalLayout {
            padding-left: root.revealed ? 28px : 68px;
            animate padding-left { duration: 260ms; easing: ease-out; }
            padding-right: 28px;
            padding-top: 12px;
            padding-bottom: 32px;
            spacing: 0px;

            // ── 头部:返回 + 游戏名 + 动作 ──────────────────────────────
                GameHeader {
                    game: root.game;
                    confirm-stop: root.confirm-stop;
                    back => { root.back(); }
                    toggle-run => { root.toggle-run(); }
                    stop-cancelled => { root.stop-cancelled(); }
                }

            // ── 路径 ──────────────────────────────────────────────────
            RevealItem {
                revealed: root.revealed;
                step: 1;
                bottom: 8px;
                SectionTitle { text: "路径"; }
            }
            RevealItem {
                revealed: root.revealed;
                step: 2;
                bottom: 24px;
                Group {
                    CardRow {
                        title: "游戏根目录";
                        description: "启动时的 CWD,也是 relative 存档路径的基准。";
                        PathField {
                            field-width: 340px;
                            text <=> root.game-dir;
                            edited(text) => { root.game-dir-changed(text); }
                            browse-enabled: root.browse-enabled;
                            browse-clicked => { root.browse-game-dir(); }
                            placeholder: "/path/to/game";
                        }
                    }
                    Divider { }
                    CardRow {
                        title: "可执行文件";
                        description: "exe 的完整路径。";
                        PathField {
                            field-width: 340px;
                            text <=> root.exe-path;
                            edited(text) => { root.exe-changed(text); }
                            browse-enabled: root.browse-enabled;
                            browse-clicked => { root.browse-exe(); }
                            placeholder: "/path/to/game.exe";
                        }
                    }
                    Divider { }
                    CardRow {
                        title: "启动参数";
                        description: "传给这个 exe 的额外参数，启动时接在它后面（如 -nojapanese）。参数之间用空格分隔；不需要就留空。";
                        TextField {
                            field-width: 340px;
                            text <=> root.launch-args;
                            edited(text) => { root.launch-args-changed(text); }
                            placeholder: "留空＝不带参数";
                        }
                    }
                    if root.path-hint != "" : VerticalLayout {
                        Divider { }
                        VerticalLayout {
                            padding: 12px;
                            Text {
                                text: root.path-hint;
                                font-size: 11px;
                                color: Tokens.text-3;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            GameLaunchGroup {
                revealed: root.revealed;
                game-direct-launch: root.game-direct-launch;
                game-auto-watch: root.game-auto-watch;
                process-name <=> root.process-name;
                direct-launch-toggled(v) => { root.direct-launch-toggled(v); }
                auto-watch-toggled(v) => { root.auto-watch-toggled(v); }
                process-name-changed(v) => { root.process-name-changed(v); }
            }

            // ── 缩放 ──────────────────────────────────────────────────
            RevealItem {
                revealed: root.revealed;
                step: 3;
                bottom: 8px;
                SectionTitle { text: "缩放"; }
            }
            RevealItem {
                revealed: root.revealed;
                step: 4;
                bottom: 24px;
                GameScaleGroup {
                    algo-options: root.algo-options;
                    algo-index: root.algo-index;
                    algo-open: root.open-select == 0;
                    show-sharpness: root.show-sharpness;
                    sharpness <=> root.sharpness;
                    fullscreen <=> root.fullscreen;
                    framerate <=> root.framerate;
                    algo-toggled(anchor) => {
                        root.algo-anchor = anchor;
                        root.open-select = root.open-select == 0 ? -1 : 0;
                    }
                    sharpness-changed(value) => { root.sharpness-changed(value); }
                    fullscreen-toggled(value) => { root.fullscreen-toggled(value); }
                    framerate-changed(text) => { root.framerate-changed(text); }
                }
            }

            // ── 高级设置 ──────────────────────────────────────────────
            // 和下面那两行灰字共用 step 5:它们说的就是这两项,一起进场更像一整段。
            RevealItem {
                revealed: root.revealed;
                step: 5;
                bottom: 8px;
                SectionTitle { text: "高级设置"; }
            }
            RevealItem {
                revealed: root.revealed;
                step: 5;
                bottom: 24px;
                GameScaleAdvancedGroup {
                    internal-w <=> root.internal-w;
                    internal-h <=> root.internal-h;
                    ratio <=> root.ratio;
                    output-w <=> root.output-w;
                    output-h <=> root.output-h;
                    gamescope-args <=> root.gamescope-args;
                    internal-w-changed(text) => { root.internal-w-changed(text); }
                    internal-h-changed(text) => { root.internal-h-changed(text); }
                    ratio-changed(text) => { root.ratio-changed(text); }
                    output-w-changed(text) => { root.output-w-changed(text); }
                    output-h-changed(text) => { root.output-h-changed(text); }
                    gamescope-args-changed(text) => { root.gamescope-args-changed(text); }
                }
            }

            // 旧 iced 版就把这三条写在详情页里,用户看得到的地方不留玄学。
            RevealItem {
                revealed: root.revealed;
                step: 5;
                bottom: 20px;
                VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: "缩放倍数 = 输出像素 ÷ 游戏自身分辨率,填了它就以它为准(输出分辨率宽/高只作参考;游戏分辨率留空时按 gamescope 的默认 1280×720 算)。启动游戏时按这个倍数开窗,快捷键「按设定比例缩放／取消缩放」(默认 Shift+Alt+Q)也是在这个倍数和 1:1 之间来回切。";
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "平铺桌面(niri)下游戏窗口铺满整块显示器,窗口尺寸不由 kotori 决定,输出分辨率只影响缩放计算;KDE 上窗口缩放走 KWin。窗口聚焦时也能用 gamescope 自带热键实时切:Super+U FSR、Super+Y NIS、Super+N 最近邻、Super+I/O 锐度增/减。";
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                }
            }

            // ── 存档位置 ──────────────────────────────────────────────
            RevealItem {
                revealed: root.revealed;
                step: 6;
                bottom: 8px;
                SectionTitle { text: "存档位置"; }
            }
            RevealItem {
                revealed: root.revealed;
                step: 7;
                bottom: 24px;
                GameSavesGroup {
                    saves: root.saves;
                    save-kinds: root.save-kinds;
                    browse-enabled: root.browse-enabled;
                    path-hint: root.path-hint;
                    open-save <=> root.open-save;
                    open-save-kind <=> root.open-save-kind;
                    add-save => { root.add-save(); }
                    remove-save(index) => { root.remove-save(index); }
                    kind-clicked(index, anchor) => {
                        root.open-save = index;
                        root.save-anchor = anchor;
                    }
                    path-changed(index, text) => { root.save-path-changed(index, text); }
                    exclude-changed(index, text) => { root.save-exclude-changed(index, text); }
                    browse-save(index) => { root.browse-save(index); }
                }
            }

            // ── 云存档(只谈这一款) ─────────────────────────────────────
            // 以前这些行在「云同步」页里一次列全部游戏,游戏一多那页就没法看了。
            RevealItem {
                revealed: root.revealed;
                step: 8;
                bottom: 8px;
                SectionTitle { text: "云存档"; }
            }
            RevealItem {
                revealed: root.revealed;
                step: 8;
                bottom: 24px;
                GameSyncGroup {
                    sync-line: root.sync-line;
                    sync-can-act: root.sync-can-act;
                    sync-pending: root.sync-pending;
                    sync-busy: root.sync-busy;
                    sync-now => { root.sync-now(); }
                    sync-restore => { root.sync-restore(); }
                    sync-restore-confirmed => { root.sync-restore-confirmed(); }
                    sync-restore-cancelled => { root.sync-restore-cancelled(); }
                }
            }

            // ── 底部动作 ──────────────────────────────────────────────
            GameActions {
                revealed: root.revealed;
                saving: root.saving;
                saved-msg: root.saved-msg;
                saved-ok: root.saved-ok;
                confirm-delete: root.confirm-delete;
                reset => { root.reset(); }
                delete-requested => { root.delete-requested(); }
                delete-cancelled => { root.delete-cancelled(); }
                delete-confirmed => { root.delete-confirmed(); }
            }


            Rectangle { vertical-stretch: 1; background: #00000000; }
        }
    }

    // 点空白处收起
    if root.open-select >= 0 || root.open-save >= 0 : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000000;
        TouchArea {
            clicked => { root.open-select = -1; root.open-save = -1; }
        }
    }

    // 浮层画在 ScrollView 之外,所以不会被视口裁掉、也盖得住下面的卡片。
    if root.open-select == 0 : DropdownList {
        // 锚点是组里那个 Select 报上来的(它现在在 game-scale.slint 里)。
        x: root.algo-anchor.x - root.absolute-position.x;
        y: root.algo-anchor.y - root.absolute-position.y + 36px;
        width: 200px;
        options: root.algo-options;
        selected: root.algo-index;
        picked(index) => {
            root.algo-index = index;
            root.open-select = -1;
            root.algo-picked(index);
        }
    }

    // 存档行的下拉:锚点是那行 Select 自己报上来的 absolute-position。
    if root.open-save >= 0 : DropdownList {
        x: root.save-anchor.x - root.absolute-position.x;
        y: root.save-anchor.y - root.absolute-position.y + 36px;
        width: 178px;
        options: root.save-kinds;
        selected: root.open-save-kind;
        picked(index) => {
            root.save-kind-picked(root.open-save, index);
            root.open-save = -1;
        }
    }
}
