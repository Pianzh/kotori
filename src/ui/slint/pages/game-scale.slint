// 「缩放」那一组(单游戏设置页用):算法、锐度、全屏、帧率。
// 「游戏分辨率」「缩放倍数」「输出分辨率」都在下面的 GameScaleAdvancedGroup 里 ——
// 它们默认留空(=自动),混在常用项里会让人以为必须填。
//
// 它自己不管浮层:算法下拉打开时把**锚点**报给页面,由页面在 ScrollView 之外画浮层
// (Slint 的 PopupWindow 既不能定位也不能逐帧动画,见 UI_GUIDE §7)。

import { Tokens } from "../theme.slint";
import { Divider } from "../widgets/base.slint";
import { Slider, Switch, TextField } from "../widgets/controls.slint";
import { Select } from "../widgets/select.slint";
import { CardRow, Group } from "../widgets/card.slint";

export component GameScaleGroup inherits Rectangle {
    in property <[string]> algo-options;
    in property <int> algo-index: 0;
    in property <bool> algo-open: false;
    in property <bool> show-sharpness: true;

    in-out property <int> sharpness: 0;
    in-out property <bool> fullscreen: false;
    in-out property <string> framerate: "";

    callback algo-toggled(Point);
    callback sharpness-changed(int);
    callback fullscreen-toggled(bool);
    callback framerate-changed(string);

    height: group.height;
    group := Group {
                    CardRow {
                        title: "缩放算法";
                        description: "决定画面放大的方式。";
                        algo := Select {
                            options: root.algo-options;
                            selected: root.algo-index;
                            open: root.algo-open;
                            toggled => { root.algo-toggled(algo.absolute-position); }
                        }
                    }
                    if root.show-sharpness : VerticalLayout {
                        Divider { }
                        CardRow {
                            title: "锐度";
                            description: "只有 FSR / NIS 有效,越大越锐(0–5)。";
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: center;
                                Slider {
                                    track-width: 200px;
                                    max: 5;
                                    value <=> root.sharpness;
                                }
                                Text {
                                    text: root.sharpness + " / 5";
                                    font-size: 13px;
                                    color: Tokens.text-2;
                                    vertical-alignment: center;
                                    min-width: 34px;
                                }
                            }
                        }
                    }
                    Divider { }
                    CardRow {
                        title: "全屏启动";
                        description: "铺满整块显示器。会盖掉上面的缩放倍数(-f 让 g_nOutput 变成屏幕尺寸)。";
                        Switch {
                            checked <=> root.fullscreen;
                            toggled => { root.fullscreen-toggled(root.fullscreen); }
                        }
                    }
                    Divider { }
                    CardRow {
                        title: "帧率限制";
                        description: "留空表示不限。";
                        TextField {
                            field-width: 100px;
                            text <=> root.framerate;
                            edited(text) => { root.framerate-changed(text); }
                            placeholder: "60";
                        }
                    }
    }
}

// 「高级设置」:平时不用碰的三项 —— **留空＝自动**。
//
// 单独一张卡片、而不是塞在上面那张里,是因为这三项的正常状态就是空着:混在常用项里
// 会让人以为必须填。填了才覆盖自动算出来的尺寸,判定只有一处
// (`ScaleProfile::internal_size` / `output_size_for`)。
export component GameScaleAdvancedGroup inherits Rectangle {
    in-out property <string> internal-w: "";
    in-out property <string> internal-h: "";
    in-out property <string> ratio: "";
    in-out property <string> output-w: "";
    in-out property <string> output-h: "";
    // 手写的 gamescope 参数,空 = 由 kotori 按上面那几项拼。
    in-out property <string> gamescope-args: "";

    callback internal-w-changed(string);
    callback internal-h-changed(string);
    callback ratio-changed(string);
    callback output-w-changed(string);
    callback output-h-changed(string);
    callback gamescope-args-changed(string);

    // 自由参数填了,下面三项当前就不生效了。**只是变淡,不禁用**:它们仍然是
    // 档案的一部分 —— 把上面那一行清空,用户之前调好的尺寸立刻回来。
    private property <bool> overridden: root.gamescope-args != "";

    height: group.height;
    group := Group {
                    CardRow {
                        title: "gamescope 参数（自定义）";
                        description: "填了它，下面三项以及上面的缩放算法、锐度、全屏、帧率就全部让位：kotori 一个参数都不发，只用你写的这一行（游戏命令仍由 kotori 接在后面）。参数之间用空格分隔，写法请对着 gamescope --help 自己核对。这一模式下 kotori 不再发任何缩放参数，缩放操作不起作用。";
                        TextField {
                            field-width: 300px;
                            text <=> root.gamescope-args;
                            edited(text) => { root.gamescope-args-changed(text); }
                            placeholder: "例如 -f -W 1920 -H 1080";
                        }
                    }
                    Divider { }
                    VerticalLayout {
                    opacity: root.overridden ? 0.45 : 1;
                    CardRow {
                        title: "游戏分辨率";
                        description: root.overridden
                            ? "当前不生效（上面填了自定义参数）。"
                            : "游戏自己渲染的尺寸(传给 gamescope 的 -w/-h)。留空＝不传,由 gamescope 用它自己的默认值(1280×720)—— 下面「缩放倍数」的除数就是它。";
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;
                            TextField {
                                field-width: 88px;
                                text <=> root.internal-w;
                                edited(text) => { root.internal-w-changed(text); }
                                placeholder: "自动";
                            }
                            Text { text: "×"; font-size: 13px; color: Tokens.text-3; vertical-alignment: center; }
                            TextField {
                                field-width: 88px;
                                text <=> root.internal-h;
                                edited(text) => { root.internal-h-changed(text); }
                                placeholder: "自动";
                            }
                        }
                    }
                    Divider { }
                    CardRow {
                        title: "缩放倍数";
                        description: root.overridden
                            ? "当前不生效（上面填了自定义参数）。"
                            : "留空＝自动(按屏幕开满)。填了就按它开窗:输出像素 ÷ 游戏分辨率。";
                        TextField {
                            field-width: 120px;
                            text <=> root.ratio;
                            edited(text) => { root.ratio-changed(text); }
                            placeholder: "自动";
                        }
                    }
                    Divider { }
                    CardRow {
                        title: "输出分辨率";
                        description: root.overridden
                            ? "当前不生效（上面填了自定义参数）。"
                            : "留空＝自动(跟随屏幕,也就是启动即最大化)。填了窗口就开这个尺寸;填了上面的倍数时以倍数优先。";
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;
                            TextField {
                                field-width: 88px;
                                text <=> root.output-w;
                                edited(text) => { root.output-w-changed(text); }
                                placeholder: "自动";
                            }
                            Text { text: "×"; font-size: 13px; color: Tokens.text-3; vertical-alignment: center; }
                            TextField {
                                field-width: 88px;
                                text <=> root.output-h;
                                edited(text) => { root.output-h-changed(text); }
                                placeholder: "自动";
                            }
                        }
                    }
                    }
    }
}
