// 「云存档」那一组(单游戏设置页用):只有这一款游戏的同步状况与两个动作。
//
// 措辞(`sync-line`)是 Rust 拼好的 —— 条件与文案不放 .slint 里,那样才测得到。

import { Tokens } from "../theme.slint";
import { Divider } from "../widgets/base.slint";
import { StdButton } from "../widgets/buttons.slint";
import { CardRow, Group } from "../widgets/card.slint";
import { Switch } from "../widgets/controls.slint";

// 这一款参不参与云同步（`GameConfig::sync_enabled`）。
//
// 用户 2026-09-24 要求补上这个入口：以前**只有**"启动前那一问"能关掉它，关了就再也
// 打不开（那一问的语义是"关掉这一款、以后直接新建身份"）。开关走一个全局而不是页面
// 属性：单游戏页那串属性是经 `app.slint` 一路转发下来的，而 `app.slint` 已经贴着
// 500 行的硬线 —— 新增的东西走全局，窗口不必替它转发。
export global GameSyncBoard {
    in-out property <bool> participating: true;
    /// 这一款现在绑的云端身份（`false` = 还没绑）。
    in-out property <bool> bound: false;
    /// 绑的那一条叫什么（云端记下的名字），以及下面那行摘要。
    in-out property <string> bound-name: "";
    in-out property <string> bound-summary: "";
    /// 正等着确认"新建一条云端身份"（两段式：先点、再确认）。
    in-out property <bool> new-pending: false;

    callback toggled(bool);
    /// 「绑定云端存档…」/「更改绑定…」：打开云端清单挑一条 —— 清单里**置顶第一条**就是
    /// 新建一条云端身份，挑它才会走到下面的确认。
    callback rebind-requested();
    /// 新建那一步的确认（两段式：先点、再确认才真的新建）。
    callback new-identity-confirmed();
    callback new-identity-cancelled();
}

export component GameSyncGroup inherits Rectangle {
    in property <string> sync-line: "";
    // 名字跟页面一致,组里那堆 `root.sync-…` 就不用改写了。
    in property <bool> sync-can-act: false;
    in property <bool> sync-pending: false;
    in property <bool> sync-busy: false;

    callback sync-now();
    callback sync-restore();
    callback sync-restore-confirmed();
    callback sync-restore-cancelled();

    height: group.height;
    group := Group {
                    CardRow {
                        title: "这一款的同步";
                        description: root.sync-line;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            if root.sync-can-act && root.sync-pending : HorizontalLayout {
                                spacing: 8px;
                                StdButton {
                                    label: "确认恢复(会覆盖本地存档)";
                                    button-width: 196px;
                                    button-enabled: !root.sync-busy;
                                    clicked => { root.sync-restore-confirmed(); }
                                }
                                StdButton {
                                    label: "取消";
                                    button-width: 68px;
                                    clicked => { root.sync-restore-cancelled(); }
                                }
                            }
                            if root.sync-can-act && !root.sync-pending : HorizontalLayout {
                                spacing: 8px;
                                StdButton {
                                    label: "立即同步";
                                    button-width: 92px;
                                    button-enabled: !root.sync-busy;
                                    clicked => { root.sync-now(); }
                                }
                                StdButton {
                                    label: "恢复";
                                    button-width: 76px;
                                    button-enabled: !root.sync-busy;
                                    clicked => { root.sync-restore(); }
                                }
                            }
                        }
                    }
                    Divider { }
                    CardRow {
                        title: "参与云同步";
                        description: "关掉之后这一款不再自动同步(启动前不取回、退出后不上传),随时能再打开;「立即同步」这类手动动作不受它限制。";
                        Switch {
                            checked <=> GameSyncBoard.participating;
                            toggled => { GameSyncBoard.toggled(GameSyncBoard.participating); }
                        }
                    }
                    Divider { }
                    CardRow {
                        title: GameSyncBoard.bound ? GameSyncBoard.bound-name : "还没绑定云端存档";
                        description: GameSyncBoard.new-pending
                            ? "确认之后这一款会往新的一条上传。云端原来那条不会删，随时能再绑回来。"
                            : (GameSyncBoard.bound ? GameSyncBoard.bound-summary : "这一款的存档上传时会在云端新建一条身份。");
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            if GameSyncBoard.new-pending : HorizontalLayout {
                                spacing: 8px;
                                StdButton {
                                    label: "确认新建";
                                    button-width: 88px;
                                    clicked => { GameSyncBoard.new-identity-confirmed(); }
                                }
                                StdButton {
                                    label: "取消";
                                    button-width: 68px;
                                    clicked => { GameSyncBoard.new-identity-cancelled(); }
                                }
                            }
                            // 绑定与换绑是同一件事：打开云端清单挑一条。**新建是那张清单里
                            // 置顶的第一条**（用户 2026-09-24："没有绑定不应该直接新建，应该
                            // 是绑定，在绑定里置顶的第一条是新建"）。
                            if !GameSyncBoard.new-pending : StdButton {
                                label: GameSyncBoard.bound ? "更改绑定…" : "绑定云端存档…";
                                button-width: 128px;
                                clicked => { GameSyncBoard.rebind-requested(); }
                            }
                        }
                    }
                    Divider { }
                    VerticalLayout {
                        padding: 16px;
                        spacing: 4px;
                        Text {
                            text: "「立即同步」= 把这款游戏的存档立刻传上去(游戏退出后本来就会自动传);「恢复」= 用云端最新的那份覆盖本地 —— 覆盖前 kotori 会先替本地拍一份快照,所以这一步是可撤销的。";
                            font-size: 11px;
                            color: Tokens.text-3;
                            wrap: word-wrap;
                        }
                    }
    }
}
