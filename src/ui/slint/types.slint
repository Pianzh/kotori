// 视图侧的数据形状。**只放 Rust 推给窗口的数据**,不放业务逻辑。
//
// 它们对应 `src/ui/model.rs` 里的 `UiGame` / `SavePathDraft` / `SyncGameRow`,
// 而不是 wire 上的 JSON —— 视图不该认识 JSON(parse.rs 已经把那层做完了)。
// Rust 侧用 `From` 从 model 类型构造它们,见 `src/ui/render.rs`。

// 游戏库里的一行。`state` 0 = 未运行、1 = 运行中、2 = 仅观测(跟着别人启动的那一局)。
export struct GameItem {
    id: string,
    name: string,
    exe: string,
    // 缩放倍数,**只有数字**(字体里的 × 天生细,见 UI_GUIDE);没配就是空串,
    // 但列宽靠 min-width 保留,否则这一列为空的行会把按钮列挤错位。
    ratio: string,
    state: int,
    // 自动追踪开着(见 `GameConfig::auto_watch`)。⚠ 它**不是**「不能启动」——
    // 它只说"别人启动的那一局也要跟",所以按钮文案与它无关。
    auto-watch: bool,
    launching: bool,
    // 自动追踪盯的进程名(单游戏设置页会显示出来,否则用户无从知道 kotori 在盯什么)。
    process: string,
}

// 单游戏设置页的**已存**值。它是「重置」的基准,也是进页面时那份副本的来源。
// ⚠ 这份数据只在进页面 / 重置 / 保存成功后刷新,**不要**拿草稿去填它 ——
// 那会让每次敲键盘都重置输入框。
export struct GameDetail {
    game-dir: string,
    exe: string,
    ratio: string,
    algo: int,
    sharpness: int,
    internal-w: string,
    internal-h: string,
    output-w: string,
    output-h: string,
    fullscreen: bool,
    framerate: string,
    // exe 的额外参数;空 = 不带参数。
    launch-args: string,
    // 用户手写的 gamescope 参数;空 = 由 kotori 按上面那些字段拼。非空时它**取代**
    // 上面全部(包括算法/锐度/全屏/帧率),见 `ScaleProfile::gamescope_args`。
    gamescope-args: string,
    // 自动追踪要盯的进程名;空 = 按 exe 文件名认(见 `GameConfig::process_name`)。
    process-name: string,
}

// 一行存档位置。`kind` 是下标:`0 = relative`、`1 = windows`、`2 = absolute`
// (顺序与 `model::SAVE_PATH_KINDS` 一致,两边改动要一起改)。
export struct SaveItem {
    kind: int,
    path: string,
    exclude: string,
    // 按形态给的示例(`%APPDATA%\Game\save` / `savedata` / 绝对路径)——
    // 空输入框里放一句能照着抄的东西,比写"存放路径"有用。
    placeholder: string,
}

// 「各游戏存档」里的一行。
export struct SyncGameItem {
    id: string,
    name: string,
    locations: int,
    last: string,
    // 这个游戏现在解析不出存档位置(盘没挂 / prefix 没了),如实写出来。
    problem: string,
    // 已经点了「恢复」、正等着二次确认。
    pending: bool,
}

// 设置页 Wine 那一组的**只读**信息(prefix 输入框自己单独一条 —— 它是 in-out,
// 用户要能编辑)。六个字段永远一起变,所以一次推一个结构体(见 `ConfigInfo`)。
export struct WineInfo {
    message: string,
    message-ok: bool,
    /// 当前生效的 prefix。
    effective: string,
    default-prefix: string,
    environment: string,
    detected: [string],
}

// 设置页「配置文件」那组:配置现在放在哪、能不能换。
// 一个结构体而不是七个散属性 —— 它们永远一起变(见 `render/settings.rs`)。
export struct ConfigInfo {
    path: string,
    label: string,
    is-portable: bool,
    can-switch: bool,
    busy: bool,
    message: string,
    message-ok: bool,
}

// 设置页「环境检查」的一行(对应 Rust 侧 `model::EnvCheck`)。
// `state`:0 可用 / 1 有条件 / 2 缺少;状态字由 Rust 给(`state-label`),
// 页面只按它挑颜色 —— 措辞不在 `.slint` 里拼。
export struct EnvCheckRow {
    title: string,
    state: int,
    state-label: string,
    detail: string,
    impact: string,
    // 按发行版给的安装命令;空 = 这一行没什么可装的。
    install: string,
}

// 「从正在运行的进程里挑」浮层里的一行(对应 Rust 侧 `model::ProcessRow`)。
export struct ProcessPickRow {
    pid: int,
    name: string,
    // 窗口标题:Windows 有,Linux 通常拿不到(空串)。
    title: string,
    // exe 的完整路径;空 = 拿不到,用户自己在界面上补。
    exe: string,
}

// 「浏览…」刚挑回来的那个值:告诉单游戏设置页"往哪个框里填"。
//
// 为什么不是直接写属性:那一页的输入框由**页面自己**持有(见 game-settings.slint
// 的文件头),窗口上没有对应的属性可写。所以 Rust 推一个令牌过去,页面自己动手 ——
// `token` 每次都 +1,这样连"又挑了一次同一个路径"也会真的触发一次 `changed`
// (属性是按值比较的,值一样就不算变化)。
export struct PathPick {
    token: int,
    // 0 = 游戏根目录、1 = 可执行文件、-1 = 谁也不填。
    target: int,
    value: string,
}

// 「配对」里一个可选的绑定：「云端的这一条 ⇄ 本机的《X》」。
export struct PairingChoice {
    local-id: string,
    local-name: string,
}

// 「配对」里的一行：云端的一条身份，以及它在本机的处境。
//
// `state` 的取值与 `src/ui/model/sync.rs` 的 `PAIRING_*` 常量一一对应：
//   0 = 已经绑着本机某一条（早先绑的）、1 = 这次扫描**自动绑上**的
//   （界面必须写明依据并给一个「不是同一款」）、2 = 像但不确定、要用户点、
//   3 = 本机没有对应的（点上传会新建一条）。
export struct PairingItem {
    cloud-key: string,
    cloud-id: string,
    cloud-short: string,
    cloud-name: string,
    machines: int,
    state: int,
    local-id: string,
    local-name: string,
    /// 这一行给用户看的那句话（措辞在 Rust 里定，见 `PairingRow::detail`）。
    detail: string,
    choices: [PairingChoice],
}
