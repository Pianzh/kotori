# Two jobs: put kotori in the application menu, and give the portal an app id
# (see APP_ID in src/hotkeys.rs — the basename here must match it).
#
# Install it *after* kotori itself is on PATH: GIO drops the whole file when the
# program named in Exec cannot be found, so the portal then reports
# "App info not found" and the runtime-scaling hotkeys never register.
[Desktop Entry]
Type=Application
Name=kotori
Comment=Galgame manager: launching, upscaling and cloud saves
Comment[zh_CN]=Galgame 集中管理器：启动、缩放增强、云存档
Exec=kotori ui
Terminal=false
Categories=Game;Utility;
Keywords=galgame;visual novel;gamescope;
StartupWMClass=kotori
